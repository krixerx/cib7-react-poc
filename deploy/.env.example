# ============================================================================
# cib7-react-poc — deployment configuration
#
#   cp .env.example .env      then edit.
#
# SINGLE-MACHINE EVALUATION: you do not need a .env file at all. Every
# value below has a localhost default baked into docker-compose.yml, and
# the dev secrets match the shipped keycloak/realm-export.json.
#
# REAL HOSTNAMES (+ TLS): every value below must be set, and the same
# hostnames/secrets must be edited into keycloak/realm-export.json BEFORE
# the first start (the realm import runs once). See README.md.
# ============================================================================

# --- Image version ------------------------------------------------------------
# Docker Hub tag for the five application images. `latest` tracks the main
# branch; pin a short commit SHA (e.g. 7b95179) for reproducible deploys.
# Available tags: https://hub.docker.com/r/krixerx/cib7-poc-frontend/tags
#IMAGE_TAG=latest

# --- Public URLs ----------------------------------------------------------------
# What end users (and their AI clients) type into the browser. Use https://
# when TLS is in front (the `tls` profile, or your own terminator).

# Public Keycloak base URL. Becomes KC_HOSTNAME_URL and the `iss` claim in
# every JWT — must be EXACTLY what the browser address bar shows during
# login, scheme included. All services validate tokens against it.
#PUBLIC_KEYCLOAK_URL=https://kc.example.com

# Public SPA base URL. Used in confirmation-email links and as the default
# MCP host.
#PUBLIC_FRONTEND_URL=https://app.example.com

# Public S3 (RustFS) endpoint — browsers upload/download documents directly
# via presigned URLs, so this must be reachable from the user's browser.
# In TLS deployments: a dedicated TLS-fronted subdomain.
#PUBLIC_S3_URL=https://s3.example.com

# Where MCP clients (Claude Desktop, Cursor, …) reach the AI sidecar.
# Only set if it differs from ${PUBLIC_FRONTEND_URL}/mcp.
#MCP_RESOURCE_URL=https://app.example.com/mcp

# Host port for the SPA's plain-HTTP front door (single-machine mode).
# In TLS mode Traefik serves :443; bind this one to loopback so the
# unencrypted port is not internet-reachable:
#FRONTEND_HTTP_PORT=127.0.0.1:3000

# Host port for the Flutter applicant app (POC) direct front door. Like
# FRONTEND_HTTP_PORT, only needed for direct access; in TLS mode Traefik
# serves it under /mobile on :443. Bind to loopback in TLS mode:
#MOBILE_HTTP_PORT=127.0.0.1:3001

# --- Keycloak admin -------------------------------------------------------------
# Bootstrap admin for the Keycloak admin console. Created on FIRST start
# only; change later via the console. Default: admin / admin.
#KEYCLOAK_ADMIN=admin
#KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME

# --- Secrets --------------------------------------------------------------------
# Defaults match the dev values in keycloak/realm-export.json, so a bare
# single-machine `docker compose up` works out of the box. For anything
# internet-reachable, generate new values (e.g. `openssl rand -base64 36`)
# and put the SAME values in keycloak/realm-export.json before first boot.

# cib7-backend client — engine identity plugin + MCP admin calls.
#KEYCLOAK_BACKEND_CLIENT_SECRET=CHANGE_ME

# cib7-webapps client — Cockpit/Tasklist/Admin SSO.
#KEYCLOAK_WEBAPPS_CLIENT_SECRET=CHANGE_ME

# cib7-business client — backend's /engine-rest service account.
#KEYCLOAK_BUSINESS_CLIENT_SECRET=CHANGE_ME

# RustFS root credentials, also used by the backend to mint presigned URLs.
#RUSTFS_ACCESS_KEY=CHANGE_ME
#RUSTFS_SECRET_KEY=CHANGE_ME

# Shared secret for the internal document-write calls; the integration bus
# (esb) injects it as X-Internal-Token, the backend verifies it.
#INTERNAL_TASK_TOKEN=CHANGE_ME
