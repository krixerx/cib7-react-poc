# ============================================================================
# cib7-react-poc — deployment configuration
#
#   cp .env.example .env      then edit.
#
# SINGLE-MACHINE EVALUATION: you do not need a .env file at all. Every
# value below has a localhost default baked into docker-compose.yml, and
# the dev secrets match the shipped keycloak/realm-export.json.
#
# REAL HOSTNAMES (+ TLS): every value below must be set, and the same
# hostnames/secrets must be edited into keycloak/realm-export.json BEFORE
# the first start (the realm import runs once). See README.md.
#
# In the TLS setup, set the profile here once instead of remembering
# `--profile tls` on every docker compose command (deploy.sh included):
#COMPOSE_PROFILES=tls
# ============================================================================

# --- Image version ------------------------------------------------------------
# Docker Hub tag for the five application images. `latest` tracks the main
# branch; pin a short commit SHA (e.g. 7b95179) for reproducible deploys.
# Available tags: https://hub.docker.com/r/krixerx/cib7-poc-frontend/tags
#IMAGE_TAG=latest

# --- Public URLs ----------------------------------------------------------------
# What end users (and their AI clients) type into the browser. Use https://
# when TLS is in front (the `tls` profile, or your own terminator).

# Public Keycloak base URL. Becomes KC_HOSTNAME_URL and the `iss` claim in
# every JWT — must be EXACTLY what the browser address bar shows during
# login, scheme included. All services validate tokens against it.
#PUBLIC_KEYCLOAK_URL=https://kc.example.com

# Public SPA base URL. Used in confirmation-email links, as the default
# MCP host, and expanded by Keycloak into the redirect URIs / web origins /
# post-logout URLs of the cib7-frontend, cib7-webapps and cib7-mobile
# clients while the realm is imported. Must be exactly the origin the
# browser shows, scheme included, or Cockpit login fails with
# "Invalid parameter: redirect_uri".
#PUBLIC_FRONTEND_URL=https://app.example.com

# Public S3 (RustFS) endpoint — browsers upload/download documents directly
# via presigned URLs, so this must be reachable from the user's browser.
# In TLS deployments: a dedicated TLS-fronted subdomain.
#PUBLIC_S3_URL=https://s3.example.com

# Where MCP clients (Claude Desktop, Cursor, …) reach the AI sidecar.
# Only set if it differs from ${PUBLIC_FRONTEND_URL}/mcp.
#MCP_RESOURCE_URL=https://app.example.com/mcp

# Contact email for Let's Encrypt, when routers in traefik/dynamic/routes.yml
# use `certResolver: le` (automatic certificates instead of supplied files).
# LE sends expiry warnings here. Unset = ACME effectively disabled.
#ACME_EMAIL=you@example.com

# Host port for the SPA's plain-HTTP front door (single-machine mode).
# In TLS mode Traefik serves :443; bind this one to loopback so the
# unencrypted port is not internet-reachable:
#FRONTEND_HTTP_PORT=127.0.0.1:3000

# Host port for the Flutter applicant app (POC) direct front door. Like
# FRONTEND_HTTP_PORT, only needed for direct access; in TLS mode Traefik
# serves it under /mobile on :443. Bind to loopback in TLS mode:
#MOBILE_HTTP_PORT=127.0.0.1:3001

# Keycloak and object-storage direct doors. Bind to loopback when they are
# served through Traefik (or another terminator) on their own hostnames:
#KEYCLOAK_HTTP_PORT=127.0.0.1:8180
#RUSTFS_HTTP_PORT=127.0.0.1:9000

# --- Keycloak admin -------------------------------------------------------------
# Bootstrap admin for the Keycloak admin console. Created on FIRST start
# only; change later via the console. Default: admin / admin.
#KEYCLOAK_ADMIN=admin
#KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME

# --- Secrets --------------------------------------------------------------------
# Defaults match the dev values in keycloak/realm-export.json, so a bare
# single-machine `docker compose up` works out of the box. For anything
# internet-reachable, generate new values with `openssl rand -hex 32` —
# hex ONLY, never base64: a `+`/`/`/`=` in a Keycloak client secret breaks
# the form-encoded token request (401 invalid_client, engine crash-loop).
# Put the SAME values in keycloak/realm-export.json before first boot.

# cib7-backend client — engine identity plugin + MCP admin calls.
#KEYCLOAK_BACKEND_CLIENT_SECRET=CHANGE_ME

# cib7-webapps client — Cockpit/Tasklist/Admin SSO.
#KEYCLOAK_WEBAPPS_CLIENT_SECRET=CHANGE_ME

# cib7-business client — backend's /engine-rest service account.
#KEYCLOAK_BUSINESS_CLIENT_SECRET=CHANGE_ME

# cib7-mailpit client — mailpit-auth (oauth2-proxy) logs demo visitors in with
# it before showing the /mailpit inbox (tls profile only).
#KEYCLOAK_MAILPIT_CLIENT_SECRET=CHANGE_ME

# mailpit-auth's session-cookie key. Exactly 32 characters: openssl rand -hex 16
#MAILPIT_PROXY_COOKIE_SECRET=CHANGE_ME

# RustFS root credentials, also used by the backend to mint presigned URLs.
#RUSTFS_ACCESS_KEY=CHANGE_ME
#RUSTFS_SECRET_KEY=CHANGE_ME

# Shared secret for the internal document-write calls; the integration bus
# (esb) injects it as X-Internal-Token, the backend verifies it.
#INTERNAL_TASK_TOKEN=CHANGE_ME

# The engine's credential towards the integration bus: cib7 sends it as
# X-Bus-Token, the esb refuses calls without it. Same value on both, from here.
#BUS_TOKEN=CHANGE_ME

# HMAC key for capability links (co-owner, founder, payment). cib7 mints
# them, the backend verifies them. Rotating it invalidates every link already sent.
#LINK_SIGNING_SECRET=CHANGE_ME

# Key the payment provider signs its callbacks with; the backend verifies it.
#PAYMENT_PROVIDER_SECRET=CHANGE_ME

# --- Database (Postgres) -----------------------------------------------------
# One Postgres container holds the engine's database (cib7) and the
# backend's (backend), each with its own login role. postgres/init creates
# both on the FIRST start of an empty data volume only: changing a value here
# later does not change the database (use ALTER ROLE in psql). Blank falls
# back to the published dev defaults in docker-compose.yml.
POSTGRES_PASSWORD=CHANGE_ME
ENGINE_DB_PASSWORD=CHANGE_ME
BACKEND_DB_PASSWORD=CHANGE_ME

# --- Centralised logging (Graylog) -------------------------------------------
# Graylog is never published on a routable interface: the web UI is bound to
# 127.0.0.1:9900 on this host and the GELF inputs are not published at all.
# Reach the UI from your workstation with an SSH tunnel:
#     ssh -N -L 9900:127.0.0.1:9900 <user>@<host>
# then open http://localhost:9900. See README.md § Centralised logging.

# Encrypts secrets Graylog stores in MongoDB. At least 16 characters, and it
# must NOT change once there is data — a new value makes the old ciphertexts
# unreadable.
#     head -c 96 /dev/urandom | base64 | tr -d '\n=+/' | head -c 96
#GRAYLOG_PASSWORD_SECRET=CHANGE_ME

# Web UI password for `admin`, in two forms. Graylog itself only takes the
# SHA-256; the plaintext is used by the graylog-init sidecar, which calls the
# REST API to create the GELF inputs. Both must be the same password.
#     echo -n 'your-password' | sha256sum
#GRAYLOG_ROOT_PASSWORD=CHANGE_ME
#GRAYLOG_ROOT_PASSWORD_SHA2=CHANGE_ME

# What the browser types once the tunnel is up. Change it if you forward to a
# different local port than 9900.
#GRAYLOG_HTTP_EXTERNAL_URI=http://127.0.0.1:9900/

# Pin a different Graylog line without editing docker-compose.yml.
#GRAYLOG_IMAGE=graylog/graylog:7.1
