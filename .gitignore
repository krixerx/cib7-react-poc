# Java / Maven
target/
*.class

# Node / Vite
node_modules/
dist/
npm-debug.log*
tsconfig.tsbuildinfo

# Local-only state — RustFS data dir, populated by the rustfs container's
# bind mount in dev (./.data/rustfs:/data). Prod uses a named docker volume
# instead so this dir doesn't exist there.
.data/

# Editor / IDE / OS
.idea/
*.iml
.vscode/
.project
.classpath
.settings/
.DS_Store
Thumbs.db

# Claude Code (local, per-machine)
**/.claude/settings.local.json
.gstack/

# Per-host deployment config & secrets — local-only, synced to the server
# out-of-band (scp), never committed, so the public bundle stays generic.
deploy/.env
deploy/docker-compose.override.yml
deploy/traefik/dynamic/*.yml
deploy/traefik/certs/*.crt
deploy/traefik/certs/*.key
# Let's Encrypt state (acme.json holds the ACME account private key)
deploy/traefik/acme/
