        <di:waypoint x="880" y="200" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="826" y="180" width="76" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_AutoApproval_Approved_di" bpmnElement="Flow_AutoApproval_Approved">
        <di:waypoint x="800" y="175" />
        <di:waypoint x="800" y="80" />
        <di:waypoint x="1155" y="80" />
        <di:waypoint x="1155" y="175" />
        <bpmndi:BPMNLabel>
