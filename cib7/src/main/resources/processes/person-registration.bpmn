      <!-- ===== Edges: send-back loop ===== -->
      <bpmndi:BPMNEdge id="Flow_SendBack_di" bpmnElement="Flow_SendBack">
        <di:waypoint x="1060" y="225" />
        <di:waypoint x="1060" y="700" />
        <di:waypoint x="730" y="700" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="836" y="682" width="55" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_AllConfirmed_SendBack_di" bpmnElement="Flow_AllConfirmed_SendBack">
        <di:waypoint x="1010" y="565" />
        <di:waypoint x="1010" y="740" />
        <di:waypoint x="730" y="740" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="858" y="722" width="47" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_SendBackEmail_Submit_di" bpmnElement="Flow_SendBackEmail_Submit">
        <di:waypoint x="600" y="720" />
        <di:waypoint x="250" y="720" />
        <di:waypoint x="250" y="240" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
