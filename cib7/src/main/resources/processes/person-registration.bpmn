<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_PersonRegistration"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="cib7-react-poc" exporterVersion="0.4.0">
  <!--
    Person Registration process.

      start (initiator = starting applicant)
        -> [Submit personal details]   user task           (applicant — PartA)
        -> (Get price)                 service task        (http-connector)
        -> {Auto approval?}            business rule task  (DMN)
        -> <Auto?>                     exclusive gateway
             autoDecision == "approve" -> <Has applicant email?>
             else                       -> [Review application] (civil-servant)
        -> [Review application]        user task           (civil-servant — PartB)
              boundary timer PT2M (non-interrupting) -> (Send reminder email)
        -> <Decision?>                 exclusive gateway
             decision == "approve" -> <Has applicant email?>
             else                   -> (Send "sent back" email) -> Submit (loop)
        -> <Has applicant email?>      exclusive gateway   (merges both approved paths)
             applicantEmail valid -> (Send approval email) -> end approved
             else (default)       -> end approved

    Process variables:
      initiator       - login of the user that started the instance (PartA owner)
      firstName, lastName, age   - written by the applicant task
      objectId                   - written by the applicant task (selected product)
      applicantEmail             - written by the applicant task (optional; when
                                   non-empty and contains "@", the approval-email
                                   service task fires)
      price                      - written by the Get price service task
      autoDecision               - written by the DMN business rule task ("approve"/"review")
      decision                   - written by the review user task ("approve"/"sendback")
      sendBackReason             - optional reason supplied by the civil servant
                                   when sending the case back for corrections
      approvalPdfBytes           - written by Generate approval PDF (Gotenberg via
                                   pdf-renderer); raw PDF bytes. Stored as a
                                   bytes-typed variable so the engine spills it
                                   to ACT_GE_BYTEARRAY instead of the 4000-char
                                   ACT_HI_VARINST.TEXT_ column.
      approvalPdfFilename        - written by Generate approval PDF; suggested
                                   filename used as the Mailpit attachment name
  -->
  <bpmn:process id="personRegistration" name="Person Registration" isExecutable="true" camunda:historyTimeToLive="P30D">

    <bpmn:startEvent id="StartEvent_1" name="Registration started" camunda:initiator="initiator">
      <bpmn:outgoing>Flow_Start_Submit</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:sequenceFlow id="Flow_Start_Submit" sourceRef="StartEvent_1" targetRef="Task_SubmitDetails" />

    <!--
      Applicant task (PartA). Assigned to the initiator so the applicant who
      started the case is the only person who can complete this step — both on
      the initial submit and when the civil servant sends the case back.
    -->
    <bpmn:userTask id="Task_SubmitDetails" name="Submit personal details"
                   camunda:formKey="react:personal-details"
                   camunda:assignee="${initiator}">
      <bpmn:incoming>Flow_Start_Submit</bpmn:incoming>
      <bpmn:incoming>Flow_SendBackEmail_Submit</bpmn:incoming>
      <bpmn:outgoing>Flow_Submit_GetPrice</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:sequenceFlow id="Flow_Submit_GetPrice" sourceRef="Task_SubmitDetails" targetRef="Task_GetPrice" />

    <bpmn:serviceTask id="Task_GetPrice" name="Get price" camunda:asyncBefore="true">
      <bpmn:extensionElements>
        <camunda:connector>
          <camunda:connectorId>http-connector</camunda:connectorId>
          <camunda:inputOutput>
            <camunda:inputParameter name="url">https://api.restful-api.dev/objects/${objectId}</camunda:inputParameter>
            <camunda:inputParameter name="method">GET</camunda:inputParameter>
            <camunda:inputParameter name="headers">
              <camunda:map>
                <camunda:entry key="Accept">application/json</camunda:entry>
              </camunda:map>
            </camunda:inputParameter>
            <!-- 'response' is the raw JSON body returned by the connector;
                 Spin parses it and we read data.price into the 'price' variable. -->
            <camunda:outputParameter name="price">${S(response).prop('data').prop('price').numberValue()}</camunda:outputParameter>
          </camunda:inputOutput>
        </camunda:connector>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Submit_GetPrice</bpmn:incoming>
      <bpmn:outgoing>Flow_GetPrice_AutoDecide</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="Flow_GetPrice_AutoDecide" sourceRef="Task_GetPrice" targetRef="Task_AutoDecide" />

    <!--
      DMN business rule task. References the "auto-approval" decision deployed
      from auto-approval.dmn (hit policy FIRST). camunda:mapDecisionResult
      maps the single-entry output into the autoDecision process variable.

      Inputs read by the DMN: age (Integer) and price (Double). Both are set
      by earlier steps before this task runs.
    -->
    <bpmn:businessRuleTask id="Task_AutoDecide" name="Auto approval?"
                           camunda:decisionRef="auto-approval"
                           camunda:mapDecisionResult="singleEntry"
                           camunda:resultVariable="autoDecision">
      <bpmn:incoming>Flow_GetPrice_AutoDecide</bpmn:incoming>
      <bpmn:outgoing>Flow_AutoDecide_Gateway</bpmn:outgoing>
    </bpmn:businessRuleTask>

    <bpmn:sequenceFlow id="Flow_AutoDecide_Gateway" sourceRef="Task_AutoDecide" targetRef="Gateway_AutoApproval" />

    <!--
      Branches on the DMN output. "approve" skips the human review and ends
      the case as approved; anything else routes to the civil servant.
    -->
    <bpmn:exclusiveGateway id="Gateway_AutoApproval" name="Auto-approve?" default="Flow_AutoApproval_Review">
      <bpmn:incoming>Flow_AutoDecide_Gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_AutoApproval_Approved</bpmn:outgoing>
      <bpmn:outgoing>Flow_AutoApproval_Review</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="Flow_AutoApproval_Approved" name="auto-approved"
                       sourceRef="Gateway_AutoApproval" targetRef="Gateway_SendApprovalEmail">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${autoDecision == "approve"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_AutoApproval_Review" name="needs review"
                       sourceRef="Gateway_AutoApproval" targetRef="Task_Review" />

    <!--
      Civil-servant task (PartB). Visible to everyone in the civil-servant
      group via candidateGroups. (The cibseven-keycloak plugin maps the
      Keycloak group path "/civil-servant" to the engine group id without
      the leading slash, so candidateGroups must match the engine view.)

      A non-interrupting timer boundary event fires every PT2M while the
      task is open and triggers a reminder email through Mailpit. "Non-
      interrupting" (cancelActivity="false") means the user task stays open
      and can fire again — handy for repeated nudges.
    -->
    <bpmn:userTask id="Task_Review" name="Review application"
                   camunda:formKey="react:review-application"
                   camunda:candidateGroups="civil-servant">
      <bpmn:incoming>Flow_AutoApproval_Review</bpmn:incoming>
      <bpmn:outgoing>Flow_Review_Gateway</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:boundaryEvent id="BoundaryEvent_ReviewReminder" name="Every 2 min"
                        attachedToRef="Task_Review" cancelActivity="false">
      <bpmn:outgoing>Flow_Reminder_Send</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <!-- ISO-8601 cycle. PT2M is a demo value — switch to PT1D / PT8H in
             production. The job executor must be running for this to fire. -->
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/PT2M</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>

    <bpmn:sequenceFlow id="Flow_Reminder_Send"
                       sourceRef="BoundaryEvent_ReviewReminder" targetRef="Task_SendReminderEmail" />

    <!--
      Reminder email via the Mailpit HTTP API. MAIL_API_URL is the engine
      container's view of Mailpit (docker-compose alias "mailpit"); the
      MailApiBaseUrlConfiguration bean exposes it as a JUEL variable.
    -->
    <bpmn:serviceTask id="Task_SendReminderEmail" name="Send reminder email"
                      camunda:asyncBefore="true">
      <bpmn:extensionElements>
        <camunda:connector>
          <camunda:connectorId>http-connector</camunda:connectorId>
          <camunda:inputOutput>
            <camunda:inputParameter name="url">${mailApiBaseUrl}/api/v1/send</camunda:inputParameter>
            <camunda:inputParameter name="method">POST</camunda:inputParameter>
            <camunda:inputParameter name="headers">
              <camunda:map>
                <camunda:entry key="Content-Type">application/json</camunda:entry>
              </camunda:map>
            </camunda:inputParameter>
            <camunda:inputParameter name="payload">{
              "From": { "Email": "process@cib7-poc.local", "Name": "CIB7 POC" },
              "To": [ { "Email": "civil-servant@cib7-poc.local", "Name": "Civil servant" } ],
              "Subject": "Reminder: application waiting for review",
              "Text": "An application from ${firstName} ${lastName} has been waiting for review. Please open the Tasks page in the SPA."
            }</camunda:inputParameter>
          </camunda:inputOutput>
        </camunda:connector>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Reminder_Send</bpmn:incoming>
      <bpmn:outgoing>Flow_Reminder_End</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="Flow_Reminder_End"
                       sourceRef="Task_SendReminderEmail" targetRef="EndEvent_ReminderSent" />

    <bpmn:endEvent id="EndEvent_ReminderSent" name="Reminder sent">
      <bpmn:incoming>Flow_Reminder_End</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_Review_Gateway" sourceRef="Task_Review" targetRef="Gateway_Decision" />

    <bpmn:exclusiveGateway id="Gateway_Decision" name="Decision?" default="Flow_SendBack">
      <bpmn:incoming>Flow_Review_Gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_Approved</bpmn:outgoing>
      <bpmn:outgoing>Flow_SendBack</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="Flow_Approved" name="approved" sourceRef="Gateway_Decision" targetRef="Gateway_SendApprovalEmail">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${decision == "approve"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!--
      Joins both approval paths (auto and manual) and decides whether to send
      the applicant a notification email. The email field on the applicant
      form is optional, so the default branch ends the case without sending
      anything; the conditional branch fires only when applicantEmail looks
      like a real address.

      Defense in depth: the form already does HTML5 type="email" validation,
      this gateway is what guarantees the service task never runs on bad data.
    -->
    <bpmn:exclusiveGateway id="Gateway_SendApprovalEmail" name="Has applicant email?" default="Flow_NoEmail_Approved">
      <bpmn:incoming>Flow_AutoApproval_Approved</bpmn:incoming>
      <bpmn:incoming>Flow_Approved</bpmn:incoming>
      <bpmn:outgoing>Flow_HasEmail</bpmn:outgoing>
      <bpmn:outgoing>Flow_NoEmail_Approved</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="Flow_HasEmail" name="valid email"
                       sourceRef="Gateway_SendApprovalEmail" targetRef="Task_GeneratePdf">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${applicantEmail != null &amp;&amp; applicantEmail.contains("@")}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!--
      Generates the approval PDF via the pdf-renderer sidecar, which wraps
      Gotenberg. The renderer accepts JSON {html, filename} and returns JSON
      {filename, base64} — that shape keeps this service task identical in
      structure to the email tasks (no multipart, no binary). Gotenberg's
      native API is multipart-in/binary-out and would require a custom Java
      delegate to plug into the http-connector pattern.
    -->
    <bpmn:serviceTask id="Task_GeneratePdf" name="Generate approval PDF"
                      camunda:asyncBefore="true">
      <bpmn:extensionElements>
        <camunda:connector>
          <camunda:connectorId>http-connector</camunda:connectorId>
          <camunda:inputOutput>
            <camunda:inputParameter name="url">${pdfApiBaseUrl}/render</camunda:inputParameter>
            <camunda:inputParameter name="method">POST</camunda:inputParameter>
            <camunda:inputParameter name="headers">
              <camunda:map>
                <camunda:entry key="Content-Type">application/json</camunda:entry>
              </camunda:map>
            </camunda:inputParameter>
            <camunda:inputParameter name="payload">
              <camunda:script scriptFormat="freemarker" resource="templates/approval-pdf.json.ftl" />
            </camunda:inputParameter>
            <!--
              response = {"filename":"approval-123.pdf","base64":"JVBERi0x..."}.
              We decode the base64 into a byte[] before storing it as the
              process variable. CIB seven puts String-typed variables in
              ACT_HI_VARINST.TEXT_ which is VARCHAR(4000); a 35 kB base64
              blob would overflow on the history flush. Bytes-typed variables
              spill to ACT_GE_BYTEARRAY, which has no size limit. The
              email template re-encodes to base64 for the Mailpit payload
              (see ${pdf.encode(approvalPdfBytes)} in approval-email.json.ftl).
            -->
            <camunda:outputParameter name="approvalPdfBytes">${pdf.decode(S(response).prop('base64').stringValue())}</camunda:outputParameter>
            <camunda:outputParameter name="approvalPdfFilename">${S(response).prop('filename').stringValue()}</camunda:outputParameter>
          </camunda:inputOutput>
        </camunda:connector>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_HasEmail</bpmn:incoming>
      <bpmn:outgoing>Flow_GeneratePdf_SendApprovalEmail</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="Flow_GeneratePdf_SendApprovalEmail"
                       sourceRef="Task_GeneratePdf" targetRef="Task_SendApprovalEmail" />

    <bpmn:sequenceFlow id="Flow_NoEmail_Approved"
                       sourceRef="Gateway_SendApprovalEmail" targetRef="EndEvent_Approved" />

    <!--
      Approval email via the Mailpit HTTP API. The payload is rendered from
      a FreeMarker template on the classpath (src/main/resources/templates/
      approval-email.json.ftl) so the body is editable without touching this
      BPMN. The connect plugin discovers FreeMarker via JSR-223 once the
      cibseven-template-engines-freemarker artifact is on the classpath —
      no Java wiring needed.
    -->
    <bpmn:serviceTask id="Task_SendApprovalEmail" name="Send approval email"
                      camunda:asyncBefore="true">
      <bpmn:extensionElements>
        <camunda:connector>
          <camunda:connectorId>http-connector</camunda:connectorId>
          <camunda:inputOutput>
            <camunda:inputParameter name="url">${mailApiBaseUrl}/api/v1/send</camunda:inputParameter>
            <camunda:inputParameter name="method">POST</camunda:inputParameter>
            <camunda:inputParameter name="headers">
              <camunda:map>
                <camunda:entry key="Content-Type">application/json</camunda:entry>
              </camunda:map>
            </camunda:inputParameter>
            <camunda:inputParameter name="payload">
              <camunda:script scriptFormat="freemarker" resource="templates/approval-email.json.ftl" />
            </camunda:inputParameter>
          </camunda:inputOutput>
        </camunda:connector>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_GeneratePdf_SendApprovalEmail</bpmn:incoming>
      <bpmn:outgoing>Flow_ApprovalEmail_End</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="Flow_ApprovalEmail_End"
                       sourceRef="Task_SendApprovalEmail" targetRef="EndEvent_Approved" />

    <!--
      Default branch: any non-approve decision (i.e. "sendback") emails the
      applicant the reason and loops the case back to the applicant.
    -->
    <bpmn:sequenceFlow id="Flow_SendBack" name="sent back"
                       sourceRef="Gateway_Decision" targetRef="Task_SendBackEmail" />

    <bpmn:serviceTask id="Task_SendBackEmail" name="Send &quot;sent back&quot; email"
                      camunda:asyncBefore="true">
      <bpmn:extensionElements>
        <camunda:connector>
          <camunda:connectorId>http-connector</camunda:connectorId>
          <camunda:inputOutput>
            <camunda:inputParameter name="url">${mailApiBaseUrl}/api/v1/send</camunda:inputParameter>
            <camunda:inputParameter name="method">POST</camunda:inputParameter>
            <camunda:inputParameter name="headers">
              <camunda:map>
                <camunda:entry key="Content-Type">application/json</camunda:entry>
              </camunda:map>
            </camunda:inputParameter>
            <camunda:inputParameter name="payload">{
              "From": { "Email": "process@cib7-poc.local", "Name": "CIB7 POC" },
              "To": [ { "Email": "${initiator}@cib7-poc.local", "Name": "${firstName} ${lastName}" } ],
              "Subject": "Your application needs corrections",
              "Text": "Hi ${firstName},\n\nThe civil servant has sent your application back for corrections. Reason: ${sendBackReason}\n\nOpen the My processes page in the SPA and resubmit when ready."
            }</camunda:inputParameter>
          </camunda:inputOutput>
        </camunda:connector>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_SendBack</bpmn:incoming>
      <bpmn:outgoing>Flow_SendBackEmail_Submit</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="Flow_SendBackEmail_Submit"
                       sourceRef="Task_SendBackEmail" targetRef="Task_SubmitDetails" />

    <bpmn:endEvent id="EndEvent_Approved" name="Application approved">
      <bpmn:incoming>Flow_NoEmail_Approved</bpmn:incoming>
      <bpmn:incoming>Flow_ApprovalEmail_End</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="personRegistration">
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="120" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="106" y="225" width="65" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SubmitDetails_di" bpmnElement="Task_SubmitDetails">
        <dc:Bounds x="200" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_GetPrice_di" bpmnElement="Task_GetPrice">
        <dc:Bounds x="340" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_AutoDecide_di" bpmnElement="Task_AutoDecide">
        <dc:Bounds x="480" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_AutoApproval_di" bpmnElement="Gateway_AutoApproval" isMarkerVisible="true">
        <dc:Bounds x="625" y="175" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="617" y="145" width="68" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Review_di" bpmnElement="Task_Review">
        <dc:Bounds x="720" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BoundaryEvent_ReviewReminder_di" bpmnElement="BoundaryEvent_ReviewReminder">
        <dc:Bounds x="752" y="222" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="734" y="265" width="72" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SendReminderEmail_di" bpmnElement="Task_SendReminderEmail">
        <dc:Bounds x="720" y="340" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_ReminderSent_di" bpmnElement="EndEvent_ReminderSent">
        <dc:Bounds x="862" y="362" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="850" y="405" width="63" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Decision_di" bpmnElement="Gateway_Decision" isMarkerVisible="true">
        <dc:Bounds x="865" y="175" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="868" y="145" width="55" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SendBackEmail_di" bpmnElement="Task_SendBackEmail">
        <dc:Bounds x="430" y="480" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_SendApprovalEmail_di" bpmnElement="Gateway_SendApprovalEmail" isMarkerVisible="true">
        <dc:Bounds x="940" y="175" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="920" y="145" width="90" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_GeneratePdf_di" bpmnElement="Task_GeneratePdf">
        <dc:Bounds x="1040" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SendApprovalEmail_di" bpmnElement="Task_SendApprovalEmail">
        <dc:Bounds x="1180" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Approved_di" bpmnElement="EndEvent_Approved">
        <dc:Bounds x="1322" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1307" y="225" width="67" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_Start_Submit_di" bpmnElement="Flow_Start_Submit">
        <di:waypoint x="156" y="200" />
        <di:waypoint x="200" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Submit_GetPrice_di" bpmnElement="Flow_Submit_GetPrice">
        <di:waypoint x="300" y="200" />
        <di:waypoint x="340" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_GetPrice_AutoDecide_di" bpmnElement="Flow_GetPrice_AutoDecide">
        <di:waypoint x="440" y="200" />
        <di:waypoint x="480" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_AutoDecide_Gateway_di" bpmnElement="Flow_AutoDecide_Gateway">
        <di:waypoint x="580" y="200" />
        <di:waypoint x="625" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_AutoApproval_Review_di" bpmnElement="Flow_AutoApproval_Review">
        <di:waypoint x="675" y="200" />
        <di:waypoint x="720" y="200" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="676" y="182" width="68" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_AutoApproval_Approved_di" bpmnElement="Flow_AutoApproval_Approved">
        <di:waypoint x="650" y="175" />
        <di:waypoint x="650" y="100" />
        <di:waypoint x="965" y="100" />
        <di:waypoint x="965" y="175" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="780" y="82" width="80" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Reminder_Send_di" bpmnElement="Flow_Reminder_Send">
        <di:waypoint x="770" y="258" />
        <di:waypoint x="770" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Reminder_End_di" bpmnElement="Flow_Reminder_End">
        <di:waypoint x="820" y="380" />
