        <di:waypoint x="1568" y="300" />
        <di:waypoint x="1568" y="218" />
      </bpmndi:BPMNEdge>

      <!-- ===== Edges: reminder branch ===== -->
      <bpmndi:BPMNEdge id="Flow_Reminder_Send_di" bpmnElement="Flow_Reminder_Send">
        <di:waypoint x="930" y="258" />
        <di:waypoint x="930" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Reminder_End_di" bpmnElement="Flow_Reminder_End">
        <di:waypoint x="980" y="380" />
        <di:waypoint x="1020" y="380" />
      </bpmndi:BPMNEdge>

      <!-- ===== Edges: owner-confirmation block ===== -->
      <bpmndi:BPMNEdge id="Flow_NeedsConfirmation_TrackingEmail_di" bpmnElement="Flow_NeedsConfirmation_TrackingEmail">
        <di:waypoint x="380" y="225" />
        <di:waypoint x="380" y="540" />
        <di:waypoint x="295" y="540" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="290" y="360" width="100" height="14" />
