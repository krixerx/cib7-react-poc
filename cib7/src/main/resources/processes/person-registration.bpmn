      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_NeedsConfirmation_GetPrice_di" bpmnElement="Flow_NeedsConfirmation_GetPrice">
        <di:waypoint x="405" y="200" />
        <di:waypoint x="460" y="200" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="408" y="180" width="89" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_GetPrice_AutoDecide_di" bpmnElement="Flow_GetPrice_AutoDecide">
        <di:waypoint x="560" y="200" />
        <di:waypoint x="620" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_AutoDecide_Gateway_di" bpmnElement="Flow_AutoDecide_Gateway">
        <di:waypoint x="720" y="200" />
        <di:waypoint x="775" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_AutoApproval_Review_di" bpmnElement="Flow_AutoApproval_Review">
