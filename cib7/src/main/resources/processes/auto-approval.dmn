<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/"
             xmlns:camunda="http://camunda.org/schema/1.0/dmn"
             xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/"
             xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/"
             xmlns:di="http://www.omg.org/spec/DMN/20180521/DI/"
             id="Definitions_AutoApproval"
             name="Vehicle registration auto-approval"
             namespace="http://camunda.org/schema/1.0/dmn"
             exporter="cib7-react-poc" exporterVersion="0.5.0">
  <!--
    Decides whether the vehicleRegistration process can skip the Transport
    Authority review or has to go through it. Hit policy FIRST: rules
    evaluated in order; the first match wins. Engine returns a single
    output via singleEntry mapping into the autoDecision variable.

    Inputs:
      age              (integer) — owner's age, written by Task_SubmitDetails
      price            (double)  — vehicle value in EUR, written by Task_GetPrice
      vehicleAgeYears  (integer) — derived from the registry's year field by
                                   Task_GetPrice (currentYear - vehicle.year)

    Output:
      autoDecision (string) — "approve" auto-completes the process,
                              "review"  routes to the Transport Authority task

    Policy summary (matches Transpordiamet POC framing):

      Underage owner       → review  (Transport Authority validates ID flow)
      Luxury (≥ €50k)      → review  (high-value always reviewed)
      Cheap and old        → approve (adult + value < €5k + ≥ 10 years old)
      Everything else      → review  (default — safe side)

    historyTimeToLive is required by CIB seven 2.1 (enforceTTL is on by default).
    P30D mirrors the BPMN's process-level TTL so history rows expire together.
  -->
  <decision id="auto-approval" name="Vehicle registration auto-approval" camunda:historyTimeToLive="P30D">
    <decisionTable id="DecisionTable_AutoApproval" hitPolicy="FIRST">
      <input id="Input_Age" label="Owner age" camunda:inputVariable="age">
        <inputExpression id="InputExpression_Age" typeRef="integer">
          <text>age</text>
        </inputExpression>
      </input>
      <input id="Input_Price" label="Vehicle value (EUR)" camunda:inputVariable="price">
        <inputExpression id="InputExpression_Price" typeRef="double">
          <text>price</text>
        </inputExpression>
      </input>
      <input id="Input_VehicleAgeYears" label="Vehicle age (years)" camunda:inputVariable="vehicleAgeYears">
        <inputExpression id="InputExpression_VehicleAgeYears" typeRef="integer">
          <text>vehicleAgeYears</text>
        </inputExpression>
      </input>
      <output id="Output_Decision" label="Decision" name="autoDecision" typeRef="string" />

      <!-- Underage owners cannot be sole registered owners; always reviewed. -->
      <rule id="Rule_UnderageOwner">
        <inputEntry id="Rule_UnderageOwner_Age"><text>&lt; 18</text></inputEntry>
        <inputEntry id="Rule_UnderageOwner_Price"><text>-</text></inputEntry>
        <inputEntry id="Rule_UnderageOwner_AgeYears"><text>-</text></inputEntry>
        <outputEntry id="Rule_UnderageOwner_Out"><text>"review"</text></outputEntry>
      </rule>

      <!-- Luxury vehicles (≥ €50k) always go to Transport Authority review. -->
      <rule id="Rule_LuxuryVehicle">
        <inputEntry id="Rule_LuxuryVehicle_Age"><text>-</text></inputEntry>
        <inputEntry id="Rule_LuxuryVehicle_Price"><text>&gt;= 50000</text></inputEntry>
        <inputEntry id="Rule_LuxuryVehicle_AgeYears"><text>-</text></inputEntry>
        <outputEntry id="Rule_LuxuryVehicle_Out"><text>"review"</text></outputEntry>
      </rule>

      <!-- Adult owner registering a low-value (< €5k), older-than-10-year
           vehicle auto-approves. Captures the routine "cheap second car"
           use case where extra Transport Authority scrutiny adds no signal. -->
      <rule id="Rule_LowValueAdultOwner">
        <inputEntry id="Rule_LowValueAdultOwner_Age"><text>&gt;= 18</text></inputEntry>
        <inputEntry id="Rule_LowValueAdultOwner_Price"><text>&lt; 5000</text></inputEntry>
        <inputEntry id="Rule_LowValueAdultOwner_AgeYears"><text>&gt;= 10</text></inputEntry>
        <outputEntry id="Rule_LowValueAdultOwner_Out"><text>"approve"</text></outputEntry>
      </rule>

      <!-- Default safe-side: anything else (mid-value, newer, etc.) gets reviewed. -->
      <rule id="Rule_DefaultReview">
        <inputEntry id="Rule_DefaultReview_Age"><text>-</text></inputEntry>
        <inputEntry id="Rule_DefaultReview_Price"><text>-</text></inputEntry>
        <inputEntry id="Rule_DefaultReview_AgeYears"><text>-</text></inputEntry>
        <outputEntry id="Rule_DefaultReview_Out"><text>"review"</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>

  <dmndi:DMNDI>
    <dmndi:DMNDiagram id="DMNDiagram_1">
      <dmndi:DMNShape id="DMNShape_AutoApproval" dmnElementRef="auto-approval">
        <dc:Bounds height="80" width="180" x="160" y="100" />
      </dmndi:DMNShape>
    </dmndi:DMNDiagram>
  </dmndi:DMNDI>
</definitions>
