<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/"
             xmlns:camunda="http://camunda.org/schema/1.0/dmn"
             id="Definitions_RopVehicleEligibility" name="ROP Vehicle Registration Eligibility"
             namespace="http://camunda.org/schema/1.0/dmn">
  <!--
    ROP ITS Demo Scenario 1 — "General Conditions" + "Special conditions".
    FIRST hit policy; the non-"ok" output doubles as the human-readable
    rejection reason rendered verbatim in the rejection-notice email.
    Spec: docs/business/services/rop-vehicle-registration/decisions/rop-vehicle-eligibility.md
  -->
  <decision id="rop-vehicle-eligibility" name="Validate registration conditions"
            camunda:historyTimeToLive="P30D">
    <decisionTable id="DecisionTable_RopVehicleEligibility" hitPolicy="FIRST">
      <input id="Input_RestrictionsCleared" label="Restrictions cleared" camunda:inputVariable="restrictionsCleared">
        <inputExpression id="InputExpression_RestrictionsCleared" typeRef="boolean"><text>restrictionsCleared</text></inputExpression>
      </input>
      <input id="Input_InspectionPassed" label="Inspection passed" camunda:inputVariable="inspectionPassed">
        <inputExpression id="InputExpression_InspectionPassed" typeRef="boolean"><text>inspectionPassed</text></inputExpression>
      </input>
      <input id="Input_Insured" label="Insured" camunda:inputVariable="insured">
        <inputExpression id="InputExpression_Insured" typeRef="boolean"><text>insured</text></inputExpression>
      </input>
      <input id="Input_ResidencyStatus" label="Residency status" camunda:inputVariable="residencyStatus">
        <inputExpression id="InputExpression_ResidencyStatus" typeRef="string"><text>residencyStatus</text></inputExpression>
      </input>
      <input id="Input_RegistrationType" label="Registration type" camunda:inputVariable="registrationType">
        <inputExpression id="InputExpression_RegistrationType" typeRef="string"><text>registrationType</text></inputExpression>
      </input>
      <output id="Output_Eligibility" label="Eligibility" name="eligibilityDecision" typeRef="string" />

      <rule id="Rule_Restrictions">
        <description>General condition 7 — fulfillment of restrictions.</description>
        <inputEntry id="Rule_Restrictions_In1"><text>false</text></inputEntry>
        <inputEntry id="Rule_Restrictions_In2"><text></text></inputEntry>
        <inputEntry id="Rule_Restrictions_In3"><text></text></inputEntry>
        <inputEntry id="Rule_Restrictions_In4"><text></text></inputEntry>
        <inputEntry id="Rule_Restrictions_In5"><text></text></inputEntry>
        <outputEntry id="Rule_Restrictions_Out"><text>"Outstanding restrictions (unpaid fines, circulars, or expired vehicles) must be fulfilled before registration."</text></outputEntry>
      </rule>
      <rule id="Rule_Inspection">
        <description>General condition 2 — pass the technical inspection.</description>
        <inputEntry id="Rule_Inspection_In1"><text></text></inputEntry>
        <inputEntry id="Rule_Inspection_In2"><text>false</text></inputEntry>
        <inputEntry id="Rule_Inspection_In3"><text></text></inputEntry>
        <inputEntry id="Rule_Inspection_In4"><text></text></inputEntry>
        <inputEntry id="Rule_Inspection_In5"><text></text></inputEntry>
        <outputEntry id="Rule_Inspection_Out"><text>"The vehicle has not passed the technical inspection."</text></outputEntry>
      </rule>
      <rule id="Rule_Insurance">
        <description>General condition 3 — the vehicle must be insured.</description>
        <inputEntry id="Rule_Insurance_In1"><text></text></inputEntry>
        <inputEntry id="Rule_Insurance_In2"><text></text></inputEntry>
        <inputEntry id="Rule_Insurance_In3"><text>false</text></inputEntry>
        <inputEntry id="Rule_Insurance_In4"><text></text></inputEntry>
        <inputEntry id="Rule_Insurance_In5"><text></text></inputEntry>
        <outputEntry id="Rule_Insurance_Out"><text>"The vehicle is not insured. Valid vehicle insurance is required."</text></outputEntry>
      </rule>
      <rule id="Rule_Visitor">
        <description>Special condition (private) 4 — no registration for visitors.</description>
        <inputEntry id="Rule_Visitor_In1"><text></text></inputEntry>
        <inputEntry id="Rule_Visitor_In2"><text></text></inputEntry>
        <inputEntry id="Rule_Visitor_In3"><text></text></inputEntry>
        <inputEntry id="Rule_Visitor_In4"><text>"visitor"</text></inputEntry>
        <inputEntry id="Rule_Visitor_In5"><text></text></inputEntry>
        <outputEntry id="Rule_Visitor_Out"><text>"Vehicles are not registered for visitors and passersby; a residence card is required."</text></outputEntry>
      </rule>
      <rule id="Rule_CommercialResident">
        <description>Special condition (commercial) 1 — not for residents.</description>
        <inputEntry id="Rule_CommercialResident_In1"><text></text></inputEntry>
        <inputEntry id="Rule_CommercialResident_In2"><text></text></inputEntry>
        <inputEntry id="Rule_CommercialResident_In3"><text></text></inputEntry>
        <inputEntry id="Rule_CommercialResident_In4"><text>"resident"</text></inputEntry>
        <inputEntry id="Rule_CommercialResident_In5"><text>"commercial"</text></inputEntry>
        <outputEntry id="Rule_CommercialResident_Out"><text>"Registration of commercial vehicles for residents is not permitted."</text></outputEntry>
      </rule>
      <rule id="Rule_DiplomaticNonDiplomat">
        <description>Diplomatic registration only for diplomatic missions (MOFA).</description>
        <inputEntry id="Rule_DiplomaticNonDiplomat_In1"><text></text></inputEntry>
        <inputEntry id="Rule_DiplomaticNonDiplomat_In2"><text></text></inputEntry>
        <inputEntry id="Rule_DiplomaticNonDiplomat_In3"><text></text></inputEntry>
        <inputEntry id="Rule_DiplomaticNonDiplomat_In4"><text>not("diplomat")</text></inputEntry>
        <inputEntry id="Rule_DiplomaticNonDiplomat_In5"><text>"diplomatic"</text></inputEntry>
        <outputEntry id="Rule_DiplomaticNonDiplomat_Out"><text>"Diplomatic registration is reserved for diplomatic missions and international organizations (Ministry of Foreign Affairs approval)."</text></outputEntry>
      </rule>
      <rule id="Rule_Ok">
        <description>Catch-all — conditions met; route to the traffic officer.</description>
        <inputEntry id="Rule_Ok_In1"><text></text></inputEntry>
        <inputEntry id="Rule_Ok_In2"><text></text></inputEntry>
        <inputEntry id="Rule_Ok_In3"><text></text></inputEntry>
        <inputEntry id="Rule_Ok_In4"><text></text></inputEntry>
        <inputEntry id="Rule_Ok_In5"><text></text></inputEntry>
        <outputEntry id="Rule_Ok_Out"><text>"ok"</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
