<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/"
             xmlns:camunda="http://camunda.org/schema/1.0/dmn"
             xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/"
             xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/"
             xmlns:di="http://www.omg.org/spec/DMN/20180521/DI/"
             id="Definitions_BusinessAutoApproval"
             name="OÜ registration auto-approval"
             namespace="http://camunda.org/schema/1.0/dmn"
             exporter="cib7-react-poc" exporterVersion="0.5.0">
  <!--
    Decides whether the businessRegistration process can skip the civil-
    servant review or has to go through it. Hit policy FIRST: rules
    evaluated in order; the first match wins. Engine returns a single
    output via singleEntry mapping into the autoDecision variable.

    Inputs:
      applicantAge  (integer) — applicant's age, written by Task_SubmitBusinessDetails
      shareCapital  (double)  — share capital in EUR, written by the same task

    Output:
      autoDecision  (string)  — "approve" auto-completes the process,
                                "review"  routes to the civil-servant task

    historyTimeToLive is required by CIB seven 2.1 (enforceTTL on by default).
    P30D mirrors the BPMN's process-level TTL so history rows expire together.
  -->
  <decision id="business-auto-approval" name="OÜ registration auto-approval"
            camunda:historyTimeToLive="P30D">
    <decisionTable id="DecisionTable_BusinessAutoApproval" hitPolicy="FIRST">
      <input id="Input_ApplicantAge" label="Founder age" camunda:inputVariable="applicantAge">
        <inputExpression id="InputExpression_ApplicantAge" typeRef="integer">
          <text>applicantAge</text>
        </inputExpression>
      </input>
      <input id="Input_ShareCapital" label="Share capital (EUR)" camunda:inputVariable="shareCapital">
        <inputExpression id="InputExpression_ShareCapital" typeRef="double">
          <text>shareCapital</text>
        </inputExpression>
      </input>
      <output id="Output_Decision" label="Decision" name="autoDecision" typeRef="string" />

      <!-- Share capital below the statutory €2500 floor always needs human review. -->
      <rule id="Rule_BelowMinimumCapital">
        <inputEntry id="Rule_BelowMinimumCapital_Age"><text>-</text></inputEntry>
        <inputEntry id="Rule_BelowMinimumCapital_Capital"><text>&lt; 2500</text></inputEntry>
        <outputEntry id="Rule_BelowMinimumCapital_Out"><text>"review"</text></outputEntry>
      </rule>

      <!-- Underage founders lack corporate-signing capacity; always reviewed. -->
      <rule id="Rule_UnderageFounder">
        <inputEntry id="Rule_UnderageFounder_Age"><text>&lt; 18</text></inputEntry>
        <inputEntry id="Rule_UnderageFounder_Capital"><text>-</text></inputEntry>
        <outputEntry id="Rule_UnderageFounder_Out"><text>"review"</text></outputEntry>
      </rule>

      <!-- Adult founder with sufficient share capital auto-approves. -->
      <rule id="Rule_AdultFounderSufficientCapital">
        <inputEntry id="Rule_AdultFounderSufficientCapital_Age"><text>&gt;= 18</text></inputEntry>
        <inputEntry id="Rule_AdultFounderSufficientCapital_Capital"><text>&gt;= 2500</text></inputEntry>
        <outputEntry id="Rule_AdultFounderSufficientCapital_Out"><text>"approve"</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>

  <dmndi:DMNDI>
    <dmndi:DMNDiagram id="DMNDiagram_1">
      <dmndi:DMNShape id="DMNShape_BusinessAutoApproval" dmnElementRef="business-auto-approval">
        <dc:Bounds height="80" width="180" x="160" y="100" />
      </dmndi:DMNShape>
    </dmndi:DMNDiagram>
  </dmndi:DMNDI>
</definitions>
