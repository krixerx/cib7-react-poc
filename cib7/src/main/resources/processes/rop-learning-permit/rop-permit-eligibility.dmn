<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/"
             xmlns:camunda="http://camunda.org/schema/1.0/dmn"
             id="Definitions_RopPermitEligibility" name="ROP Learning Permit Eligibility"
             namespace="http://camunda.org/schema/1.0/dmn">
  <!--
    ROP ITS Demo Scenario 2 — "Terms of Service". FIRST hit policy. Output:
    "ok" proceeds to payment, "medical" routes to the Police Hospital
    branch (weak vision), anything else is the human-readable rejection
    reason rendered verbatim in the rejection notice.
    Spec: docs/business/services/rop-learning-permit/decisions/rop-permit-eligibility.md
  -->
  <decision id="rop-permit-eligibility" name="Check terms of service"
            camunda:historyTimeToLive="P30D">
    <decisionTable id="DecisionTable_RopPermitEligibility" hitPolicy="FIRST">
      <input id="Input_RestrictionsCleared" label="Restrictions cleared" camunda:inputVariable="restrictionsCleared">
        <inputExpression id="InputExpression_RestrictionsCleared" typeRef="boolean"><text>restrictionsCleared</text></inputExpression>
      </input>
      <input id="Input_HasValidLicense" label="Has valid temporary license" camunda:inputVariable="hasValidTemporaryLicense">
        <inputExpression id="InputExpression_HasValidLicense" typeRef="boolean"><text>hasValidTemporaryLicense</text></inputExpression>
      </input>
      <input id="Input_Age" label="Age" camunda:inputVariable="age">
        <inputExpression id="InputExpression_Age" typeRef="integer"><text>age</text></inputExpression>
      </input>
      <input id="Input_LicenseCategory" label="License category" camunda:inputVariable="licenseCategory">
        <inputExpression id="InputExpression_LicenseCategory" typeRef="string"><text>licenseCategory</text></inputExpression>
      </input>
      <input id="Input_SpecialNeeds" label="Special needs" camunda:inputVariable="specialNeeds">
        <inputExpression id="InputExpression_SpecialNeeds" typeRef="boolean"><text>specialNeeds</text></inputExpression>
      </input>
      <input id="Input_ResidencyStatus" label="Residency status" camunda:inputVariable="residencyStatus">
        <inputExpression id="InputExpression_ResidencyStatus" typeRef="string"><text>residencyStatus</text></inputExpression>
      </input>
      <input id="Input_HasResidentCard" label="Has resident card" camunda:inputVariable="hasResidentCard">
        <inputExpression id="InputExpression_HasResidentCard" typeRef="boolean"><text>hasResidentCard</text></inputExpression>
      </input>
      <input id="Input_EyeTestResult" label="Eye test result" camunda:inputVariable="eyeTestResult">
        <inputExpression id="InputExpression_EyeTestResult" typeRef="string"><text>eyeTestResult</text></inputExpression>
      </input>
      <output id="Output_PermitDecision" label="Permit decision" name="permitDecision" typeRef="string" />

      <rule id="Rule_Restrictions">
        <description>Demo: checking restrictions (violations, circulars).</description>
        <inputEntry id="Rule_Restrictions_In1"><text>false</text></inputEntry>
        <inputEntry id="Rule_Restrictions_In2"><text></text></inputEntry>
        <inputEntry id="Rule_Restrictions_In3"><text></text></inputEntry>
        <inputEntry id="Rule_Restrictions_In4"><text></text></inputEntry>
        <inputEntry id="Rule_Restrictions_In5"><text></text></inputEntry>
        <inputEntry id="Rule_Restrictions_In6"><text></text></inputEntry>
        <inputEntry id="Rule_Restrictions_In7"><text></text></inputEntry>
        <inputEntry id="Rule_Restrictions_In8"><text></text></inputEntry>
        <outputEntry id="Rule_Restrictions_Out"><text>"Outstanding traffic restrictions (violations or circulars) must be cleared first."</text></outputEntry>
      </rule>
      <rule id="Rule_ExistingLicense">
        <description>Demo: not having a new (temporary) valid driving license.</description>
        <inputEntry id="Rule_ExistingLicense_In1"><text></text></inputEntry>
        <inputEntry id="Rule_ExistingLicense_In2"><text>true</text></inputEntry>
        <inputEntry id="Rule_ExistingLicense_In3"><text></text></inputEntry>
        <inputEntry id="Rule_ExistingLicense_In4"><text></text></inputEntry>
        <inputEntry id="Rule_ExistingLicense_In5"><text></text></inputEntry>
        <inputEntry id="Rule_ExistingLicense_In6"><text></text></inputEntry>
        <inputEntry id="Rule_ExistingLicense_In7"><text></text></inputEntry>
        <inputEntry id="Rule_ExistingLicense_In8"><text></text></inputEntry>
        <outputEntry id="Rule_ExistingLicense_Out"><text>"You already hold a valid (temporary) driving license; a new learning permit cannot be issued."</text></outputEntry>
      </rule>
      <rule id="Rule_MinAge">
        <description>Demo: completion of the legal age (18) years.</description>
        <inputEntry id="Rule_MinAge_In1"><text></text></inputEntry>
        <inputEntry id="Rule_MinAge_In2"><text></text></inputEntry>
        <inputEntry id="Rule_MinAge_In3"><text>&lt; 18</text></inputEntry>
        <inputEntry id="Rule_MinAge_In4"><text></text></inputEntry>
        <inputEntry id="Rule_MinAge_In5"><text></text></inputEntry>
        <inputEntry id="Rule_MinAge_In6"><text></text></inputEntry>
        <inputEntry id="Rule_MinAge_In7"><text></text></inputEntry>
        <inputEntry id="Rule_MinAge_In8"><text></text></inputEntry>
        <outputEntry id="Rule_MinAge_Out"><text>"The legal minimum age for a learning permit is 18 years."</text></outputEntry>
      </rule>
      <rule id="Rule_HeavyAge">
        <description>Demo: mechanical equipment and heavy vehicles require age 21.</description>
        <inputEntry id="Rule_HeavyAge_In1"><text></text></inputEntry>
        <inputEntry id="Rule_HeavyAge_In2"><text></text></inputEntry>
        <inputEntry id="Rule_HeavyAge_In3"><text>&lt; 21</text></inputEntry>
        <inputEntry id="Rule_HeavyAge_In4"><text>"heavy-vehicle","mechanical-equipment"</text></inputEntry>
        <inputEntry id="Rule_HeavyAge_In5"><text></text></inputEntry>
        <inputEntry id="Rule_HeavyAge_In6"><text></text></inputEntry>
        <inputEntry id="Rule_HeavyAge_In7"><text></text></inputEntry>
        <inputEntry id="Rule_HeavyAge_In8"><text></text></inputEntry>
        <outputEntry id="Rule_HeavyAge_Out"><text>"The legal minimum age for heavy vehicle and mechanical equipment licenses is 21 years."</text></outputEntry>
      </rule>
      <rule id="Rule_SpecialNeeds">
        <description>Demo: special needs not eligible for mechanical equipment, heavy vehicles, motorcycles.</description>
        <inputEntry id="Rule_SpecialNeeds_In1"><text></text></inputEntry>
        <inputEntry id="Rule_SpecialNeeds_In2"><text></text></inputEntry>
        <inputEntry id="Rule_SpecialNeeds_In3"><text></text></inputEntry>
        <inputEntry id="Rule_SpecialNeeds_In4"><text>"heavy-vehicle","mechanical-equipment","motorcycle"</text></inputEntry>
        <inputEntry id="Rule_SpecialNeeds_In5"><text>true</text></inputEntry>
        <inputEntry id="Rule_SpecialNeeds_In6"><text></text></inputEntry>
        <inputEntry id="Rule_SpecialNeeds_In7"><text></text></inputEntry>
        <inputEntry id="Rule_SpecialNeeds_In8"><text></text></inputEntry>
        <outputEntry id="Rule_SpecialNeeds_Out"><text>"Persons with special needs are not eligible for mechanical equipment, heavy vehicle, or motorcycle licenses."</text></outputEntry>
      </rule>
      <rule id="Rule_GccResidentCard">
        <description>Demo: GCC-country citizens must hold a resident card.</description>
        <inputEntry id="Rule_GccResidentCard_In1"><text></text></inputEntry>
        <inputEntry id="Rule_GccResidentCard_In2"><text></text></inputEntry>
        <inputEntry id="Rule_GccResidentCard_In3"><text></text></inputEntry>
        <inputEntry id="Rule_GccResidentCard_In4"><text></text></inputEntry>
        <inputEntry id="Rule_GccResidentCard_In5"><text></text></inputEntry>
        <inputEntry id="Rule_GccResidentCard_In6"><text>"gcc-citizen"</text></inputEntry>
        <inputEntry id="Rule_GccResidentCard_In7"><text>false</text></inputEntry>
        <inputEntry id="Rule_GccResidentCard_In8"><text></text></inputEntry>
        <outputEntry id="Rule_GccResidentCard_Out"><text>"Citizens of Gulf Cooperation Council countries are required to hold a resident card."</text></outputEntry>
      </rule>
      <rule id="Rule_EyeFail">
        <description>Demo: pass the eye test (approved opticians linkage).</description>
        <inputEntry id="Rule_EyeFail_In1"><text></text></inputEntry>
        <inputEntry id="Rule_EyeFail_In2"><text></text></inputEntry>
        <inputEntry id="Rule_EyeFail_In3"><text></text></inputEntry>
        <inputEntry id="Rule_EyeFail_In4"><text></text></inputEntry>
        <inputEntry id="Rule_EyeFail_In5"><text></text></inputEntry>
        <inputEntry id="Rule_EyeFail_In6"><text></text></inputEntry>
        <inputEntry id="Rule_EyeFail_In7"><text></text></inputEntry>
        <inputEntry id="Rule_EyeFail_In8"><text>"fail"</text></inputEntry>
        <outputEntry id="Rule_EyeFail_Out"><text>"The eye test result from the approved optician does not meet the vision requirements."</text></outputEntry>
      </rule>
      <rule id="Rule_EyeMissing">
        <description>No eye test on file at any approved optical shop.</description>
        <inputEntry id="Rule_EyeMissing_In1"><text></text></inputEntry>
        <inputEntry id="Rule_EyeMissing_In2"><text></text></inputEntry>
        <inputEntry id="Rule_EyeMissing_In3"><text></text></inputEntry>
        <inputEntry id="Rule_EyeMissing_In4"><text></text></inputEntry>
        <inputEntry id="Rule_EyeMissing_In5"><text></text></inputEntry>
        <inputEntry id="Rule_EyeMissing_In6"><text></text></inputEntry>
        <inputEntry id="Rule_EyeMissing_In7"><text></text></inputEntry>
        <inputEntry id="Rule_EyeMissing_In8"><text>"missing"</text></inputEntry>
        <outputEntry id="Rule_EyeMissing_Out"><text>"No eye test result from an approved optician is on file. Please visit an approved optical shop first."</text></outputEntry>
      </rule>
      <rule id="Rule_EyeWeak">
        <description>Weak vision routes to the Police Hospital medical assessment.</description>
        <inputEntry id="Rule_EyeWeak_In1"><text></text></inputEntry>
        <inputEntry id="Rule_EyeWeak_In2"><text></text></inputEntry>
        <inputEntry id="Rule_EyeWeak_In3"><text></text></inputEntry>
        <inputEntry id="Rule_EyeWeak_In4"><text></text></inputEntry>
        <inputEntry id="Rule_EyeWeak_In5"><text></text></inputEntry>
        <inputEntry id="Rule_EyeWeak_In6"><text></text></inputEntry>
        <inputEntry id="Rule_EyeWeak_In7"><text></text></inputEntry>
        <inputEntry id="Rule_EyeWeak_In8"><text>"weak"</text></inputEntry>
        <outputEntry id="Rule_EyeWeak_Out"><text>"medical"</text></outputEntry>
      </rule>
      <rule id="Rule_Ok">
        <description>Catch-all — all terms met; proceed to fee payment.</description>
        <inputEntry id="Rule_Ok_In1"><text></text></inputEntry>
        <inputEntry id="Rule_Ok_In2"><text></text></inputEntry>
        <inputEntry id="Rule_Ok_In3"><text></text></inputEntry>
        <inputEntry id="Rule_Ok_In4"><text></text></inputEntry>
        <inputEntry id="Rule_Ok_In5"><text></text></inputEntry>
        <inputEntry id="Rule_Ok_In6"><text></text></inputEntry>
        <inputEntry id="Rule_Ok_In7"><text></text></inputEntry>
        <inputEntry id="Rule_Ok_In8"><text></text></inputEntry>
        <outputEntry id="Rule_Ok_Out"><text>"ok"</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
