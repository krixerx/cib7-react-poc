<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_TransportLearningPermit"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="cib7-react-poc" exporterVersion="0.6.0">
  <!--
    Transport Driving Learner Permit — ITS Demo Scenario 2.

      start (initiator = applicant)
        -> [Apply for a learning permit]  user task (applicant — PartA)
              flat 6 EUR fee shown in the form before submit
        -> (Fetch eye test, license & restrictions status)  service task
              GET /api/public/transport/driver-clearance/{civilId} (backend stand-in
              for approved opticians + license registry + restrictions)
        -> {Check terms of service}  business rule task (DMN
              transport-permit-eligibility -> permitDecision: "ok" | "medical" |
              human-readable rejection sentence)
        -> <Conditions met?>
             ok             -> (Email: pay the service fee)
             medical        -> (Email: visit the Police Hospital)
                                -> [Police Hospital medical assessment] user task
                                     (civil-servant plays the hospital board)
                                -> <Medical result?>
                                     positive       -> (Email: pay the service fee)
                                     else (default) -> (Email: application rejected)
             else (default) -> (Email: application rejected) -> end rejected
        -> [Wait for fee payment]  receiveTask (msg "PaymentReceived";
              PaymentController charges the flat 6 EUR for this key)
        -> (Issue learning permit)  POST /api/public/transport/learning-permits/issue
              (persists transport_learning_permits; permit number + 1y validity)
        -> (Generate electronic learning license PDF)  pdf-renderer
              (license + payment receipt in one document)
        -> (Store learning license)  server-upload, category generated-certificate
        -> (Email: electronic license & receipt)  PDF attached
        -> (Email: service evaluation request)
        -> end (Learning permit issued)

    No send-back loop — the demo scenario has none; rejected applicants
    start a new case. Process variables: see
    docs/business/services/transport-learning-permit/README.md. permitPdfBytes is
    bytes-typed — stored bytes to spill to ACT_GE_BYTEARRAY.

    Spec lives at docs/business/services/transport-learning-permit/. Generated by
    .claude/skills/service-builder.
  -->

  <bpmn:message id="Message_PaymentReceived" name="PaymentReceived" />

  <bpmn:process id="transportLearningPermit" name="Transport Driving Learner Permit"
                isExecutable="true" camunda:historyTimeToLive="P30D">
    <bpmn:startEvent id="StartEvent_1" name="Application submitted"
                     camunda:initiator="initiator">
      <bpmn:outgoing>Flow_Start</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:sequenceFlow id="Flow_Start"
                       sourceRef="StartEvent_1" targetRef="Task_TransportPermitApplication" />

    <bpmn:userTask id="Task_TransportPermitApplication" name="Apply for a learning permit"
                   camunda:formKey="react:transport-permit-application"
                   camunda:assignee="${initiator}">
      <bpmn:incoming>Flow_Start</bpmn:incoming>
      <bpmn:outgoing>Flow_Application_Clearance</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:sequenceFlow id="Flow_Application_Clearance"
                       sourceRef="Task_TransportPermitApplication" targetRef="Task_TransportDriverClearance" />

    <!--
      Driver clearance stand-in: approved-opticians eye test, existing
      temporary license, violations/circulars restrictions. Unknown civil
      IDs come back all-clear with a passed eye test; the seeded demo IDs
      trigger the other branches. Fallbacks fail safe (missing ->
      actionable rejection, never silent approval).
    -->
    <bpmn:serviceTask id="Task_TransportDriverClearance" name="Fetch eye test, license &amp; restrictions status"
                      camunda:asyncBefore="true">
      <bpmn:extensionElements>
        <camunda:connector>
          <camunda:connectorId>http-connector</camunda:connectorId>
          <camunda:inputOutput>
            <camunda:inputParameter name="url">${busBaseUrl}/api/public/transport/driver-clearance/${civilId}</camunda:inputParameter>
            <camunda:inputParameter name="method">GET</camunda:inputParameter>
            <camunda:inputParameter name="headers">
              <camunda:map>
                <camunda:entry key="Accept">application/json</camunda:entry>
              </camunda:map>
            </camunda:inputParameter>
            <camunda:outputParameter name="eyeTestResult">${!S(response).hasProp('eyeTestResult') ? 'missing' : S(response).prop('eyeTestResult').stringValue()}</camunda:outputParameter>
            <camunda:outputParameter name="hasValidTemporaryLicense">${!S(response).hasProp('hasValidTemporaryLicense') ? false : S(response).prop('hasValidTemporaryLicense').boolValue()}</camunda:outputParameter>
            <camunda:outputParameter name="restrictionsCleared">${!S(response).hasProp('restrictionsCleared') ? false : S(response).prop('restrictionsCleared').boolValue()}</camunda:outputParameter>
          </camunda:inputOutput>
        </camunda:connector>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Application_Clearance</bpmn:incoming>
      <bpmn:outgoing>Flow_Clearance_Eligibility</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="Flow_Clearance_Eligibility"
                       sourceRef="Task_TransportDriverClearance" targetRef="Task_TransportPermitEligibility" />

    <bpmn:businessRuleTask id="Task_TransportPermitEligibility" name="Check terms of service"
                           camunda:decisionRef="transport-permit-eligibility"
                           camunda:decisionRefBinding="deployment"
                           camunda:mapDecisionResult="singleEntry"
                           camunda:resultVariable="permitDecision">
      <bpmn:incoming>Flow_Clearance_Eligibility</bpmn:incoming>
      <bpmn:outgoing>Flow_Eligibility_Conditions</bpmn:outgoing>
    </bpmn:businessRuleTask>

    <bpmn:sequenceFlow id="Flow_Eligibility_Conditions"
                       sourceRef="Task_TransportPermitEligibility" targetRef="Gateway_PermitConditions" />

    <bpmn:exclusiveGateway id="Gateway_PermitConditions" name="Conditions met?"
                           default="Flow_Conditions_Rejected">
      <bpmn:incoming>Flow_Eligibility_Conditions</bpmn:incoming>
      <bpmn:outgoing>Flow_Conditions_Payment</bpmn:outgoing>
      <bpmn:outgoing>Flow_Conditions_Medical</bpmn:outgoing>
      <bpmn:outgoing>Flow_Conditions_Rejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="Flow_Conditions_Payment" name="conditions met"
                       sourceRef="Gateway_PermitConditions" targetRef="Task_TransportPermitPaymentEmail">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${permitDecision == "ok"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_Conditions_Medical" name="weak vision"
                       sourceRef="Gateway_PermitConditions" targetRef="Task_TransportHospitalNoticeEmail">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${permitDecision == "medical"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_Conditions_Rejected" name="rejected"
                       sourceRef="Gateway_PermitConditions" targetRef="Task_TransportPermitRejectionEmail" />

    <!--
      Demo: "the system sends a notification to the service applicant to go
      to the police hospital (to extract a medical report stating the
      eligibility for the license)".
    -->
    <bpmn:serviceTask id="Task_TransportHospitalNoticeEmail" name="Email: visit the Police Hospital"
                      camunda:asyncBefore="true">
      <bpmn:extensionElements>
        <camunda:connector>
          <camunda:connectorId>http-connector</camunda:connectorId>
          <camunda:inputOutput>
            <camunda:inputParameter name="url">${busBaseUrl}/api/v1/send</camunda:inputParameter>
            <camunda:inputParameter name="method">POST</camunda:inputParameter>
            <camunda:inputParameter name="headers">
              <camunda:map>
                <camunda:entry key="Content-Type">application/json</camunda:entry>
              </camunda:map>
            </camunda:inputParameter>
            <camunda:inputParameter name="payload">
              <camunda:script scriptFormat="freemarker" resource="templates/transport-hospital-notice-email.json.ftl" />
            </camunda:inputParameter>
          </camunda:inputOutput>
        </camunda:connector>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Conditions_Medical</bpmn:incoming>
      <bpmn:outgoing>Flow_HospitalNotice_Assessment</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="Flow_HospitalNotice_Assessment"
                       sourceRef="Task_TransportHospitalNoticeEmail" targetRef="Task_TransportHospitalAssessment" />

    <!--
      The civil-servant group plays the Police Hospital medical board —
      the POC stand-in for the demo's automatic electronic linkage between
      ITS and the hospital system (see the spec's Known trade-offs).
    -->
    <bpmn:userTask id="Task_TransportHospitalAssessment" name="Police Hospital medical assessment"
                   camunda:formKey="react:transport-hospital-assessment"
                   camunda:candidateGroups="civil-servant">
      <bpmn:incoming>Flow_HospitalNotice_Assessment</bpmn:incoming>
      <bpmn:outgoing>Flow_Assessment_MedicalResult</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:sequenceFlow id="Flow_Assessment_MedicalResult"
                       sourceRef="Task_TransportHospitalAssessment" targetRef="Gateway_MedicalResult" />

    <bpmn:exclusiveGateway id="Gateway_MedicalResult" name="Medical result?"
                           default="Flow_Medical_Rejected">
      <bpmn:incoming>Flow_Assessment_MedicalResult</bpmn:incoming>
      <bpmn:outgoing>Flow_Medical_Payment</bpmn:outgoing>
      <bpmn:outgoing>Flow_Medical_Rejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="Flow_Medical_Payment" name="fit to drive"
                       sourceRef="Gateway_MedicalResult" targetRef="Task_TransportPermitPaymentEmail">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${medicalResult == "positive"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_Medical_Rejected" name="not fit"
                       sourceRef="Gateway_MedicalResult" targetRef="Task_TransportPermitRejectionEmail" />

    <!--
      Shared rejection notice — two incoming flows: DMN terms-of-service
      rejection (permitDecision text IS the reason) and Police Hospital
      negative assessment (rejectionReason wins).
    -->
    <bpmn:serviceTask id="Task_TransportPermitRejectionEmail" name="Email: application rejected"
                      camunda:asyncBefore="true">
      <bpmn:extensionElements>
        <camunda:connector>
          <camunda:connectorId>http-connector</camunda:connectorId>
          <camunda:inputOutput>
            <camunda:inputParameter name="url">${busBaseUrl}/api/v1/send</camunda:inputParameter>
            <camunda:inputParameter name="method">POST</camunda:inputParameter>
            <camunda:inputParameter name="headers">
              <camunda:map>
                <camunda:entry key="Content-Type">application/json</camunda:entry>
              </camunda:map>
            </camunda:inputParameter>
            <camunda:inputParameter name="payload">
              <camunda:script scriptFormat="freemarker" resource="templates/transport-permit-rejection-email.json.ftl" />
            </camunda:inputParameter>
          </camunda:inputOutput>
        </camunda:connector>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Conditions_Rejected</bpmn:incoming>
      <bpmn:incoming>Flow_Medical_Rejected</bpmn:incoming>
      <bpmn:outgoing>Flow_RejectionEmail_Rejected</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="Flow_RejectionEmail_Rejected"
                       sourceRef="Task_TransportPermitRejectionEmail" targetRef="EndEvent_Rejected" />

    <bpmn:endEvent id="EndEvent_Rejected" name="Application rejected">
      <bpmn:incoming>Flow_RejectionEmail_Rejected</bpmn:incoming>
    </bpmn:endEvent>

    <!--
      Payment request — two incoming flows: straight-through "ok" path and
      the hospital's positive assessment. Flat 6 EUR (demo's Service Fee);
      PaymentController charges the same flat amount for this key.
    -->
    <bpmn:serviceTask id="Task_TransportPermitPaymentEmail" name="Email: pay the service fee"
                      camunda:asyncBefore="true">
      <bpmn:extensionElements>
        <camunda:connector>
          <camunda:connectorId>http-connector</camunda:connectorId>
          <camunda:inputOutput>
            <camunda:inputParameter name="url">${busBaseUrl}/api/v1/send</camunda:inputParameter>
            <camunda:inputParameter name="method">POST</camunda:inputParameter>
            <camunda:inputParameter name="headers">
              <camunda:map>
                <camunda:entry key="Content-Type">application/json</camunda:entry>
              </camunda:map>
            </camunda:inputParameter>
            <camunda:inputParameter name="payload">
              <camunda:script scriptFormat="freemarker" resource="templates/transport-permit-payment-email.json.ftl" />
            </camunda:inputParameter>
          </camunda:inputOutput>
        </camunda:connector>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Conditions_Payment</bpmn:incoming>
      <bpmn:incoming>Flow_Medical_Payment</bpmn:incoming>
      <bpmn:outgoing>Flow_PaymentEmail_Wait</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="Flow_PaymentEmail_Wait"
                       sourceRef="Task_TransportPermitPaymentEmail" targetRef="Task_TransportWaitPermitPayment" />

    <bpmn:receiveTask id="Task_TransportWaitPermitPayment" name="Wait for fee payment"
                      messageRef="Message_PaymentReceived">
      <bpmn:incoming>Flow_PaymentEmail_Wait</bpmn:incoming>
      <bpmn:outgoing>Flow_Wait_IssuePermit</bpmn:outgoing>
    </bpmn:receiveTask>

    <bpmn:sequenceFlow id="Flow_Wait_IssuePermit"
                       sourceRef="Task_TransportWaitPermitPayment" targetRef="Task_TransportIssuePermit" />

    <!--
      System-of-record write: persists transport_learning_permits and returns
      permitNumber + validUntil (one year). No defensive fallback — a
      registry failure must raise an incident, not issue an unnumbered
      permit.
    -->
    <bpmn:serviceTask id="Task_TransportIssuePermit" name="Issue learning permit"
                      camunda:asyncBefore="true">
      <bpmn:extensionElements>
        <camunda:connector>
          <camunda:connectorId>http-connector</camunda:connectorId>
          <camunda:inputOutput>
            <camunda:inputParameter name="url">${busBaseUrl}/api/public/transport/learning-permits/issue</camunda:inputParameter>
            <camunda:inputParameter name="method">POST</camunda:inputParameter>
            <camunda:inputParameter name="headers">
              <camunda:map>
                <camunda:entry key="Content-Type">application/json</camunda:entry>
                <camunda:entry key="Accept">application/json</camunda:entry>
              </camunda:map>
            </camunda:inputParameter>
            <camunda:inputParameter name="payload">
              <camunda:script scriptFormat="freemarker" resource="templates/transport-issue-permit.json.ftl" />
            </camunda:inputParameter>
            <camunda:outputParameter name="permitNumber">${S(response).prop('permitNumber').stringValue()}</camunda:outputParameter>
            <camunda:outputParameter name="permitValidUntil">${S(response).prop('validUntil').stringValue()}</camunda:outputParameter>
          </camunda:inputOutput>
        </camunda:connector>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Wait_IssuePermit</bpmn:incoming>
      <bpmn:outgoing>Flow_IssuePermit_Pdf</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="Flow_IssuePermit_Pdf"
                       sourceRef="Task_TransportIssuePermit" targetRef="Task_TransportPermitPdf" />

    <bpmn:serviceTask id="Task_TransportPermitPdf" name="Generate electronic learning license (PDF)"
                      camunda:asyncBefore="true">
      <bpmn:extensionElements>
        <camunda:connector>
          <camunda:connectorId>http-connector</camunda:connectorId>
          <camunda:inputOutput>
            <camunda:inputParameter name="url">${busBaseUrl}/render</camunda:inputParameter>
            <camunda:inputParameter name="method">POST</camunda:inputParameter>
            <camunda:inputParameter name="headers">
              <camunda:map>
                <camunda:entry key="Content-Type">application/json</camunda:entry>
              </camunda:map>
            </camunda:inputParameter>
            <camunda:inputParameter name="payload">
              <camunda:script scriptFormat="freemarker" resource="templates/transport-permit-pdf.json.ftl" />
            </camunda:inputParameter>
            <!-- stored bytes to spill to ACT_GE_BYTEARRAY -->
            <camunda:outputParameter name="permitPdfBytes">${pdf.decode(S(response).prop('base64').stringValue())}</camunda:outputParameter>
            <camunda:outputParameter name="permitPdfFilename">${S(response).prop('filename').stringValue()}</camunda:outputParameter>
          </camunda:inputOutput>
        </camunda:connector>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_IssuePermit_Pdf</bpmn:incoming>
      <bpmn:outgoing>Flow_Pdf_Store</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="Flow_Pdf_Store"
                       sourceRef="Task_TransportPermitPdf" targetRef="Task_TransportStorePermit" />

    <bpmn:serviceTask id="Task_TransportStorePermit" name="Store learning license"
                      camunda:asyncBefore="true">
      <bpmn:extensionElements>
        <camunda:connector>
          <camunda:connectorId>http-connector</camunda:connectorId>
          <camunda:inputOutput>
            <camunda:inputParameter name="url">${busBaseUrl}/api/documents/server-upload</camunda:inputParameter>
            <camunda:inputParameter name="method">POST</camunda:inputParameter>
            <camunda:inputParameter name="headers">
              <camunda:map>
                <camunda:entry key="Content-Type">application/json</camunda:entry>
              </camunda:map>
            </camunda:inputParameter>
            <camunda:inputParameter name="payload">
              <camunda:script scriptFormat="freemarker" resource="templates/transport-store-permit.json.ftl" />
            </camunda:inputParameter>
            <camunda:outputParameter name="permitAttachmentId">${S(response).prop('attachmentId').stringValue()}</camunda:outputParameter>
          </camunda:inputOutput>
        </camunda:connector>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Pdf_Store</bpmn:incoming>
      <bpmn:outgoing>Flow_Store_PermitEmail</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="Flow_Store_PermitEmail"
                       sourceRef="Task_TransportStorePermit" targetRef="Task_TransportPermitEmail" />

    <bpmn:serviceTask id="Task_TransportPermitEmail" name="Email: electronic license &amp; receipt"
                      camunda:asyncBefore="true">
      <bpmn:extensionElements>
        <camunda:connector>
          <camunda:connectorId>http-connector</camunda:connectorId>
          <camunda:inputOutput>
            <camunda:inputParameter name="url">${busBaseUrl}/api/v1/send</camunda:inputParameter>
            <camunda:inputParameter name="method">POST</camunda:inputParameter>
            <camunda:inputParameter name="headers">
              <camunda:map>
                <camunda:entry key="Content-Type">application/json</camunda:entry>
              </camunda:map>
            </camunda:inputParameter>
            <camunda:inputParameter name="payload">
              <camunda:script scriptFormat="freemarker" resource="templates/transport-permit-email.json.ftl" />
            </camunda:inputParameter>
          </camunda:inputOutput>
        </camunda:connector>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Store_PermitEmail</bpmn:incoming>
      <bpmn:outgoing>Flow_PermitEmail_Evaluation</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="Flow_PermitEmail_Evaluation"
                       sourceRef="Task_TransportPermitEmail" targetRef="Task_TransportPermitEvaluationEmail" />

    <bpmn:serviceTask id="Task_TransportPermitEvaluationEmail" name="Email: service evaluation request"
                      camunda:asyncBefore="true">
      <bpmn:extensionElements>
        <camunda:connector>
          <camunda:connectorId>http-connector</camunda:connectorId>
          <camunda:inputOutput>
            <camunda:inputParameter name="url">${busBaseUrl}/api/v1/send</camunda:inputParameter>
            <camunda:inputParameter name="method">POST</camunda:inputParameter>
            <camunda:inputParameter name="headers">
              <camunda:map>
                <camunda:entry key="Content-Type">application/json</camunda:entry>
              </camunda:map>
            </camunda:inputParameter>
            <camunda:inputParameter name="payload">
              <camunda:script scriptFormat="freemarker" resource="templates/transport-permit-evaluation-email.json.ftl" />
            </camunda:inputParameter>
          </camunda:inputOutput>
        </camunda:connector>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_PermitEmail_Evaluation</bpmn:incoming>
      <bpmn:outgoing>Flow_Evaluation_Issued</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="Flow_Evaluation_Issued"
                       sourceRef="Task_TransportPermitEvaluationEmail" targetRef="EndEvent_Issued" />

    <bpmn:endEvent id="EndEvent_Issued" name="Learning permit issued">
      <bpmn:incoming>Flow_Evaluation_Issued</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>

  <!--
    BPMNDI: three horizontal bands, functional-not-pretty:
      y = 160   main row: start -> application -> clearance -> eligibility ->
                <conditions met?>
      y = 400   hospital branch + payment/issuance pipeline
      y = 680   rejection band (shared email + end)
  -->
  <bpmndi:BPMNDiagram id="BPMNDiagram_TransportLearningPermit">
    <bpmndi:BPMNPlane id="BPMNPlane_TransportLearningPermit" bpmnElement="transportLearningPermit">

      <!-- Main row -->
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="160" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="138" y="225" width="80" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_TransportPermitApplication_di" bpmnElement="Task_TransportPermitApplication">
        <dc:Bounds x="240" y="160" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_TransportDriverClearance_di" bpmnElement="Task_TransportDriverClearance">
        <dc:Bounds x="420" y="160" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_TransportPermitEligibility_di" bpmnElement="Task_TransportPermitEligibility">
        <dc:Bounds x="620" y="160" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_PermitConditions_di" bpmnElement="Gateway_PermitConditions" isMarkerVisible="true">
        <dc:Bounds x="800" y="175" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="785" y="145" width="80" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Hospital branch -->
      <bpmndi:BPMNShape id="Task_TransportHospitalNoticeEmail_di" bpmnElement="Task_TransportHospitalNoticeEmail">
        <dc:Bounds x="900" y="160" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_TransportHospitalAssessment_di" bpmnElement="Task_TransportHospitalAssessment">
        <dc:Bounds x="1090" y="160" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_MedicalResult_di" bpmnElement="Gateway_MedicalResult" isMarkerVisible="true">
        <dc:Bounds x="1290" y="175" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="1278" y="145" width="76" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Payment + issuance pipeline -->
      <bpmndi:BPMNShape id="Task_TransportPermitPaymentEmail_di" bpmnElement="Task_TransportPermitPaymentEmail">
        <dc:Bounds x="240" y="400" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_TransportWaitPermitPayment_di" bpmnElement="Task_TransportWaitPermitPayment">
        <dc:Bounds x="420" y="400" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_TransportIssuePermit_di" bpmnElement="Task_TransportIssuePermit">
        <dc:Bounds x="600" y="400" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_TransportPermitPdf_di" bpmnElement="Task_TransportPermitPdf">
        <dc:Bounds x="780" y="400" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_TransportStorePermit_di" bpmnElement="Task_TransportStorePermit">
        <dc:Bounds x="980" y="400" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_TransportPermitEmail_di" bpmnElement="Task_TransportPermitEmail">
        <dc:Bounds x="1160" y="400" width="150" height="80" />
      </bpmndi:BPMNShape>
