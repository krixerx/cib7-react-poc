<?xml version="1.0" encoding="UTF-8"?>
<!-- For ReservedBeansPluginTest: resolves busBaseUrl once through JUEL and
     once through a FreeMarker script, then parks so the test can read both. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                  id="Definitions_ReservedTest"
                  targetNamespace="http://poc.cib7/test">
  <bpmn:process id="reservedBeansTest" isExecutable="true" camunda:historyTimeToLive="P1D">
    <bpmn:startEvent id="Start" />
    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="Resolve" />
    <bpmn:manualTask id="Resolve">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:outputParameter name="viaJuel">${busBaseUrl}</camunda:outputParameter>
          <camunda:outputParameter name="viaFreemarker">
            <camunda:script scriptFormat="freemarker">${busBaseUrl}|${frontendBaseUrl}</camunda:script>
          </camunda:outputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
    </bpmn:manualTask>
    <bpmn:sequenceFlow id="F2" sourceRef="Resolve" targetRef="Wait" />
    <bpmn:receiveTask id="Wait" />
    <bpmn:sequenceFlow id="F3" sourceRef="Wait" targetRef="End" />
    <bpmn:endEvent id="End" />
  </bpmn:process>
</bpmn:definitions>
