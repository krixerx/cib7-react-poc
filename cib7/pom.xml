<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.6</version>
    <relativePath/>
  </parent>

  <groupId>com.poc.cib7</groupId>
  <artifactId>cib7-react-poc-cib7</artifactId>
  <version>0.1.0</version>
  <packaging>jar</packaging>
  <name>cib7-react-poc-cib7</name>
  <description>CIB seven 2.1 process engine module for the React human-tasks POC</description>

  <properties>
    <java.version>17</java.version>
    <cibseven.version>2.1.0</cibseven.version>
  </properties>

  <dependencies>
    <!-- CIB seven 2.1 engine + REST API (registers /engine-rest). -->
    <dependency>
      <groupId>org.cibseven.bpm.springboot</groupId>
      <artifactId>cibseven-bpm-spring-boot-starter-rest</artifactId>
      <version>${cibseven.version}</version>
    </dependency>

    <!-- Embedded servlet container for Spring MVC + the REST servlet. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- In-memory database: with no datasource configured, Spring Boot
         auto-configures an in-memory H2 instance for the engine. -->
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- CIB seven Connect plugin: makes the engine parse and run
         <camunda:connector> service tasks. Brings cibseven-connect-core. -->
    <dependency>
      <groupId>org.cibseven.bpm</groupId>
      <artifactId>cibseven-engine-plugin-connect</artifactId>
      <version>${cibseven.version}</version>
    </dependency>

    <!-- CIB seven Keycloak Identity Provider Plugin: registers a
         ReadOnlyIdentityProvider that queries Keycloak's Admin REST API
         for users and groups. Engine then knows who the authenticated
         caller is and which groups they belong to, so candidateGroups
         on user tasks are actually enforced. Plugin version is aligned
         with CIB seven 2.1. -->
    <dependency>
      <groupId>org.cibseven.bpm.extension</groupId>
      <artifactId>cibseven-keycloak</artifactId>
      <version>${cibseven.version}</version>
    </dependency>

    <!-- Spring Security + OAuth2 resource server: validates incoming
         bearer tokens (signature, expiry, issuer, audience) against
         Keycloak's JWKS. The plugin's example RestApiSecurityConfig
         relies on these starters being on the classpath. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
    </dependency>
    <!-- oauth2-client is intentionally NOT included. The plugin's
         sso-kubernetes example pulled it in for the webapp OAuth2 login
         flow + an OAuth2AuthorizedClientService bean. Our setup has no
         webapps (the React SPA performs OIDC itself), and including the
         starter pulls in auto-config that calls OIDC discovery against
         our issuer URI at startup — fatal in docker-compose where the
         backend can't reach the browser's public Keycloak URL. The
         filter's OAuth2AuthorizedClientService parameter is therefore
         declared optional and stays null in the JWT path. -->


    <!-- The REST + DataSonnet connector — built as the sibling reactor
         module 'connector' (a git submodule). -->
    <dependency>
      <groupId>org.cibseven.community</groupId>
      <artifactId>rest-datasonnet-connector</artifactId>
      <version>0.1.0-SNAPSHOT</version>
    </dependency>

    <!-- HTTP client the connector uses; it declares httpclient5 as
         'provided', so the runtime classpath must supply it. -->
    <dependency>
      <groupId>org.apache.httpcomponents.client5</groupId>
      <artifactId>httpclient5</artifactId>
      <version>5.5</version>
    </dependency>

    <!-- DataSonnet 2.5.2's Java format plugin loads javax.xml.bind classes in
         its static initializer. Spring Boot 3's dependency management upgrades
         the connector's transitive jakarta.xml.bind-api to the Jakarta-4
         namespace, which no longer ships javax.xml.bind.*. Pin the standalone
         javax JAXB 2.3.1 API + impl explicitly (Spring Boot 3 does not manage
         these coordinates) so com.datasonnet.spi.DataFormatService initializes. -->
    <dependency>
      <groupId>javax.xml.bind</groupId>
      <artifactId>jaxb-api</artifactId>
      <version>2.3.1</version>
    </dependency>
    <dependency>
      <groupId>com.sun.xml.bind</groupId>
      <artifactId>jaxb-impl</artifactId>
      <version>2.3.1</version>
      <scope>runtime</scope>
    </dependency>
  </dependencies>

  <!--
    Project-local Maven repository for the rest-datasonnet connector, which is
    not yet published to a public repository. lib/ holds the connector JAR and
    POM in standard repository layout. Once the connector is published, delete
    this <repositories> block and the lib/ folder — the <dependency> above is
    a normal dependency and stays unchanged.
  -->
  <repositories>
    <repository>
      <id>project-local-lib</id>
      <name>Project-local library repository</name>
      <url>file://${project.basedir}/../lib</url>
      <releases>
        <enabled>false</enabled>
      </releases>
      <snapshots>
        <enabled>true</enabled>
        <checksumPolicy>ignore</checksumPolicy>
      </snapshots>
    </repository>
  </repositories>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
