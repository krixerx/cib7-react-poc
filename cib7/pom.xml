<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.6</version>
    <relativePath/>
  </parent>

  <groupId>com.poc.cib7</groupId>
  <artifactId>cib7-react-poc-cib7</artifactId>
  <version>0.1.0</version>
  <packaging>jar</packaging>
  <name>cib7-react-poc-cib7</name>
  <description>CIB seven 2.1 process engine module for the React human-tasks POC</description>

  <properties>
    <java.version>17</java.version>
    <cibseven.version>2.1.0</cibseven.version>
  </properties>

  <dependencies>
    <!-- CIB seven 2.1 engine + REST API + Cockpit/Tasklist/Admin webapps.
         The webapp starter transitively brings the rest starter, so we only
         need one. The webapps are served from /camunda/* once the second
         SecurityFilterChain (see com.poc.cib7.keycloak.WebappSecurityConfig)
         is on the classpath. -->
    <dependency>
      <groupId>org.cibseven.bpm.springboot</groupId>
      <artifactId>cibseven-bpm-spring-boot-starter-webapp</artifactId>
      <version>${cibseven.version}</version>
    </dependency>

    <!-- Embedded servlet container for Spring MVC + the REST servlet. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- In-memory database: with no datasource configured, Spring Boot
         auto-configures an in-memory H2 instance for the engine. -->
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- CIB seven Connect plugin: makes the engine parse and run
         <camunda:connector> service tasks. Brings cibseven-connect-core. -->
    <dependency>
      <groupId>org.cibseven.bpm</groupId>
      <artifactId>cibseven-engine-plugin-connect</artifactId>
      <version>${cibseven.version}</version>
    </dependency>

    <!-- Official HTTP connector (connectorId="http-connector"). Pulls in
         httpclient5 transitively. The "Get price" service task in
         person-registration.bpmn uses it to call api.restful-api.dev. -->
    <dependency>
      <groupId>org.cibseven.connect</groupId>
      <artifactId>cibseven-connect-http-client</artifactId>
      <version>${cibseven.version}</version>
    </dependency>

    <!-- Spin engine plugin: registers the S() / JSON() / XML() JUEL functions
         so the BPMN can parse the http-connector's response body inline (e.g.
         ${S(response).prop('data').prop('price').numberValue()}). The Spin
         starter dependencies are <optional> in the CIB seven Spring Boot
         starter, so we pull them in explicitly. The Jackson dataformat
         registers the JSON SPI Spin needs to auto-detect the response body —
         without it, S(response) fails with SPIN-01004 "No matching data
         format detected". -->
    <dependency>
      <groupId>org.cibseven.bpm</groupId>
      <artifactId>cibseven-engine-plugin-spin</artifactId>
      <version>${cibseven.version}</version>
    </dependency>
    <dependency>
      <groupId>org.cibseven.spin</groupId>
      <artifactId>cibseven-spin-dataformat-json-jackson</artifactId>
      <version>${cibseven.version}</version>
    </dependency>

    <!-- CIB seven Keycloak Identity Provider Plugin: registers a
         ReadOnlyIdentityProvider that queries Keycloak's Admin REST API
         for users and groups. Engine then knows who the authenticated
         caller is and which groups they belong to, so candidateGroups
         on user tasks are actually enforced. Plugin version is aligned
         with CIB seven 2.1. -->
    <dependency>
      <groupId>org.cibseven.bpm.extension</groupId>
      <artifactId>cibseven-keycloak</artifactId>
      <version>${cibseven.version}</version>
    </dependency>

    <!-- Spring Security + OAuth2 resource server: validates incoming
         bearer tokens (signature, expiry, issuer, audience) against
         Keycloak's JWKS. The plugin's example RestApiSecurityConfig
         relies on these starters being on the classpath. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
    </dependency>
    <!-- oauth2-client drives the legacy webapps' OAuth2 login flow against
         Keycloak (Authorization Code grant). The auto-config DOES NOT call
         OIDC discovery because we provide every endpoint explicitly under
         spring.security.oauth2.client.provider.keycloak.* (no issuer-uri).
         That keeps the engine startable in docker-compose, where the
         container can't reach the browser-visible Keycloak URL. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-oauth2-client</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
