<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>

  <groupId>com.poc.cib7</groupId>
  <artifactId>cib7-react-poc-cib7</artifactId>
  <version>0.1.0</version>
  <packaging>jar</packaging>
  <name>cib7-react-poc-cib7</name>
  <description>CIB seven 2.2 process engine module for the React human-tasks POC</description>

  <properties>
    <!-- Security pins over Boot 4.1.1's managed versions, which still carry
         fixable HIGH/CRITICAL CVEs that fail the image scan (Trivy in
         docker-publish.yml); the same pins as backend/. Jackson 2 is still
         used by Spin and the engine's own JSON handling; 2.21.7 is what the
         image scan passed with on Boot 3.5. Drop each pin once a Boot release
         manages that version or newer. -->
    <tomcat.version>11.0.25</tomcat.version>
    <jackson-bom.version>3.1.7</jackson-bom.version>
    <jackson-2-bom.version>2.21.7</jackson-2-bom.version>
    <java.version>21</java.version>
    <logback-gelf.version>6.1.2</logback-gelf.version>
    <cibseven.version>2.2.0</cibseven.version>
    <!-- The service pack's engine files (processes/, templates/, documents/). They are not
         in this module: at runtime the image puts them on the classpath from
         /opt/services, and for tests and `mvn spring-boot:run` this directory
         is added to the classpath instead. Override with
         -Dservices.pack.dir=... to run against another pack. -->
    <services.pack.dir>${project.basedir}/../packs/test/engine</services.pack.dir>
    <!-- The Keycloak identity-provider extension. 2.2.x is its Spring
         Framework 7 line; 2.1.0 is built against Spring 6.2 and fails in the
         running engine on Spring 7 ("HttpHeaders does not implement
         MultiValueMap"), which the tests do not show because they mock
         Keycloak. It rides its own version property because it releases
         separately from the engine. -->
    <cibseven.keycloak.version>2.2.1</cibseven.keycloak.version>
    <!-- DocumentRenderer asks for Configuration.VERSION_2_3_35, newer than the
         FreeMarker the Boot BOM manages. -->
    <freemarker.version>2.3.35</freemarker.version>
  </properties>

  <dependencies>
    <!-- GELF appender for Logback: ships every log event to Graylog over UDP.
         Spring Boot can *format* GELF onto the console since 3.4
         (logging.structured.format.console=gelf) but ships no GELF transport,
         and this is the transport. Zero transitive dependencies; needs
         Logback >= 1.5.15, and the Boot parent manages 1.5.34. Only wired up
         under the `graylog` Spring profile — see resources/logback-spring.xml. -->
    <dependency>
      <groupId>de.siegmar</groupId>
      <artifactId>logback-gelf</artifactId>
      <version>${logback-gelf.version}</version>
    </dependency>

    <!-- CIB seven engine + Cockpit/Tasklist/Admin webapps, in the Spring Boot 4
         variants (the `-4` starters, on Spring Framework 7). The webapps
         are served from /camunda/*, behind the security starter's login.
         Despite the name, the webapp starter does NOT transitively register
         the engine REST API at /engine-rest — only the JAX-RS resource
         classes (cibseven-engine-rest-core-jakarta). The REST starter below
         is what actually wires those resources into the Spring servlet. -->
    <dependency>
      <groupId>org.cibseven.bpm.springboot</groupId>
      <artifactId>cibseven-bpm-spring-boot-starter-webapp-4</artifactId>
      <version>${cibseven.version}</version>
      <!-- cibseven-webclient-core bundles five JDBC drivers at runtime scope,
           at versions that carried the image's pgjdbc and mssql-jdbc CVEs. All
           are excluded; the Postgres driver comes back below at the version
           Spring Boot manages. -->
      <exclusions>
        <exclusion>
          <groupId>org.postgresql</groupId>
          <artifactId>postgresql</artifactId>
        </exclusion>
        <exclusion>
          <groupId>com.microsoft.sqlserver</groupId>
          <artifactId>mssql-jdbc</artifactId>
        </exclusion>
        <exclusion>
          <groupId>com.mysql</groupId>
          <artifactId>mysql-connector-j</artifactId>
        </exclusion>
        <exclusion>
          <groupId>org.mariadb.jdbc</groupId>
          <artifactId>mariadb-java-client</artifactId>
        </exclusion>
        <exclusion>
          <groupId>com.oracle.database.jdbc</groupId>
          <artifactId>ojdbc17</artifactId>
        </exclusion>
      </exclusions>
    </dependency>

    <!-- CIB seven REST API starter. Mounts the engine REST resources at
         /engine-rest/*. Without it the SPA's calls to /engine-rest/... get
         a 404 once they pass the security filter. -->
    <dependency>
      <groupId>org.cibseven.bpm.springboot</groupId>
      <artifactId>cibseven-bpm-spring-boot-starter-rest-4</artifactId>
      <version>${cibseven.version}</version>
    </dependency>

    <!-- Embedded servlet container for Spring MVC + the REST servlet. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- In-memory database: with no datasource configured, Spring Boot
         auto-configures an in-memory H2 instance for the engine. -->
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- CIB seven Connect plugin: makes the engine parse and run
         <camunda:connector> service tasks. Brings cibseven-connect-core. -->
    <dependency>
      <groupId>org.cibseven.bpm</groupId>
      <artifactId>cibseven-engine-plugin-connect</artifactId>
      <version>${cibseven.version}</version>
    </dependency>

    <!-- Official HTTP connector (connectorId="http-connector"). Pulls in
         httpclient5 transitively. The "Look up vehicle in registry" service
         task in vehicle-registration.bpmn uses it to call the backend
         microservice's vehicle registry via apiBaseUrl. -->
    <dependency>
      <groupId>org.cibseven.connect</groupId>
      <artifactId>cibseven-connect-http-client</artifactId>
      <version>${cibseven.version}</version>
    </dependency>

    <!-- FreeMarker template engine for connector input parameters. Lets the
         "Send approval email" service task assemble its JSON payload from a
         classpath template (templates/approval-email.json.ftl) instead of
         inlining the body in the BPMN. Discovered via JSR-223 — no Spring
         wiring needed; the connect plugin uses scriptFormat="freemarker" to
         look up the engine. -->
    <dependency>
      <groupId>org.cibseven.template-engines</groupId>
      <artifactId>cibseven-template-engines-freemarker</artifactId>
      <version>${cibseven.version}</version>
    </dependency>

    <!-- Spin engine plugin: registers the S() / JSON() / XML() JUEL functions
         so the BPMN can parse the http-connector's response body inline (e.g.
         ${S(response).prop('data').prop('price').numberValue()}). The Spin
         starter dependencies are <optional> in the CIB seven Spring Boot
         starter, so we pull them in explicitly. The Jackson dataformat
         registers the JSON SPI Spin needs to auto-detect the response body —
         without it, S(response) fails with SPIN-01004 "No matching data
         format detected". -->
    <dependency>
      <groupId>org.cibseven.bpm</groupId>
      <artifactId>cibseven-engine-plugin-spin</artifactId>
      <version>${cibseven.version}</version>
    </dependency>
    <dependency>
      <groupId>org.cibseven.spin</groupId>
      <artifactId>cibseven-spin-dataformat-json-jackson</artifactId>
      <version>${cibseven.version}</version>
    </dependency>

    <!-- CIB seven Keycloak Identity Provider Plugin: registers a
         ReadOnlyIdentityProvider that queries Keycloak's Admin REST API
         for users and groups. Engine then knows who the authenticated
         caller is and which groups they belong to, so candidateGroups
         on user tasks are actually enforced. From 2.2.0 it is published
         as org.cibseven.community.keycloak; org.cibseven.bpm.extension
         stops at 2.1.0. -->
    <dependency>
      <groupId>org.cibseven.community.keycloak</groupId>
      <artifactId>cibseven-keycloak</artifactId>
      <version>${cibseven.keycloak.version}</version>
    </dependency>

    <!-- CIB seven's OAuth2 integration: the /engine-rest resource server
         (Bearer JWT, then the caller and their groups on the engine's
         IdentityService) and the webapps' Authorization Code login. Brings
         Spring Security with the OAuth2 resource server and client
         starters. Its own token-based identity provider is switched off in
         application.yaml; the Keycloak plugin above is the identity
         provider. -->
    <dependency>
      <groupId>org.cibseven.bpm.springboot</groupId>
      <artifactId>cibseven-bpm-spring-boot-starter-security-4</artifactId>
      <version>${cibseven.version}</version>
    </dependency>
    <!-- Persistent database (the `postgres` profile) and Flyway, which owns
         the ACT_* schema (com.poc.cib7.db.V1__CibSevenSchema). Versions are
         managed by the Spring Boot parent. -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- Boot 4 moved Flyway's auto-configuration into its own module: with
         flyway-core alone, nothing runs the migrations. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-flyway</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <!-- Validates submitted form values against the service pack's
         schemas/<form-id>.json (docs/security.md rule 2). The 2.x line is the
         Jackson 2 one; 3.x needs Jackson 3, and the engine's JSON handling and
         Spin still use Jackson 2. -->
    <dependency>
      <groupId>com.networknt</groupId>
      <artifactId>json-schema-validator</artifactId>
      <version>3.0.8</version>
    </dependency>

    <!-- JUnit 5 + AssertJ + Mockito + Spring Test. The DMN tests run the
         standalone DMN engine (cibseven-engine-dmn, already on the classpath
         transitively via the webapp starter); the smoke test boots the full
         Spring context with the Keycloak identity plugin mocked out. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <!-- Tests deploy and render the pack's BPMN, DMN and templates, so the pack
         directory joins the test classpath. -->
    <testResources>
      <testResource>
        <directory>src/test/resources</directory>
      </testResource>
      <testResource>
        <directory>${services.pack.dir}</directory>
      </testResource>
      <!-- The pack's manifest, checked at startup (PackManifest). -->
      <testResource>
        <directory>${services.pack.dir}/..</directory>
        <includes>
          <include>pack.yaml</include>
        </includes>
      </testResource>
      <!-- The pack's branding, read by the documents as classpath:branding/. -->
      <testResource>
        <directory>${services.pack.dir}/../branding</directory>
        <targetPath>branding</targetPath>
      </testResource>
    </testResources>
    <plugins>
      <!-- The build and the tests run on the JDK production runs (eclipse-temurin
           21 in the Dockerfile, java-version 21 in CI). A newer local JDK still
           compiles for 21 (java.version) but runs the tests on another JVM, so
           it is refused with a clear message instead. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>require-jdk-21</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[21,22)</version>
                  <message>This module builds and tests on JDK 21 (as the image runs it). Set JAVA_HOME to a JDK 21.</message>
                </requireJavaVersion>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <!-- The pack's engine files at the classpath root, and the pack root
               itself, so pack.yaml and branding/ resolve from the classpath
               (the image copies both into /opt/services instead). -->
          <folders>
            <folder>${services.pack.dir}</folder>
            <folder>${services.pack.dir}/..</folder>
          </folders>
        </configuration>
      </plugin>
      <!-- Google Java Style, enforced: `spotless:check` runs during `verify`,
           `mvn spotless:apply` reformats. Requires the add-exports flags in
           the repo-root .mvn/jvm.config (google-java-format reaches into
           jdk.compiler internals on JDK 16+). -->
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>3.10.3</version>
        <configuration>
          <java>
            <googleJavaFormat>
              <version>1.36.1</version>
              <style>GOOGLE</style>
            </googleJavaFormat>
          </java>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
