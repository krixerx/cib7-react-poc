<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>com.poc.cib7</groupId>
  <artifactId>cib7-react-poc-cib7</artifactId>
  <version>0.1.0</version>
  <packaging>jar</packaging>
  <name>cib7-react-poc-cib7</name>
  <description>CIB seven 2.2 process engine module for the React human-tasks POC</description>

  <properties>
    <java.version>21</java.version>
    <logback-gelf.version>6.1.2</logback-gelf.version>
    <cibseven.version>2.2.0</cibseven.version>
    <!-- The service pack's engine files (processes/, templates/). They are not
         in this module: at runtime the image puts them on the classpath from
         /opt/services, and for tests and `mvn spring-boot:run` this directory
         is added to the classpath instead. Override with
         -Dservices.pack.dir=... to run against another pack. -->
    <services.pack.dir>${project.basedir}/../packs/reference/engine</services.pack.dir>
    <!-- The Keycloak identity-provider extension has no 2.2.0 release (latest
         is 2.1.0, built against Spring Framework 6.2 = the Boot 3.5 line, which
         is exactly what this module runs). It rides its own version property so
         the engine can move ahead of it. It is also why this module stays on
         Boot 3.5 while backend/ runs Boot 4: CIB seven ships Boot 4 variants of
         its starters (the `-4` artifacts), but the Keycloak extension has no
         Spring Framework 7 build. -->
    <cibseven.keycloak.version>2.1.0</cibseven.keycloak.version>
    <!-- Security pins over Boot 3.5.16's managed versions, which still carry
         fixable HIGH/CRITICAL CVEs that fail the image scan (Trivy in
         docker-publish.yml). Boot 3.5.16 is the newest 3.5 patch, so there is
         no parent bump to take instead. Drop each pin once a Boot release
         manages that version or newer. -->
    <tomcat.version>10.1.59</tomcat.version>
    <jackson-bom.version>2.21.7</jackson-bom.version>
    <freemarker.version>2.3.35</freemarker.version>
    <httpcore5.version>5.4.3</httpcore5.version>
  </properties>

  <dependencies>
    <!-- GELF appender for Logback: ships every log event to Graylog over UDP.
         Spring Boot can *format* GELF onto the console since 3.4
         (logging.structured.format.console=gelf) but ships no GELF transport,
         and this is the transport. Zero transitive dependencies; needs
         Logback >= 1.5.15, and the Boot parent manages 1.5.34. Only wired up
         under the `graylog` Spring profile — see resources/logback-spring.xml. -->
    <dependency>
      <groupId>de.siegmar</groupId>
      <artifactId>logback-gelf</artifactId>
      <version>${logback-gelf.version}</version>
    </dependency>

    <!-- CIB seven engine + Cockpit/Tasklist/Admin webapps. The webapps
         are served from /camunda/* once the second SecurityFilterChain (see
         com.poc.cib7.keycloak.WebappSecurityConfig) is on the classpath.
         Despite the name, the webapp starter does NOT transitively register
         the engine REST API at /engine-rest — only the JAX-RS resource
         classes (cibseven-engine-rest-core-jakarta). The REST starter below
         is what actually wires those resources into the Spring servlet. -->
    <dependency>
      <groupId>org.cibseven.bpm.springboot</groupId>
      <artifactId>cibseven-bpm-spring-boot-starter-webapp</artifactId>
      <version>${cibseven.version}</version>
      <!-- cibseven-webclient-core bundles five JDBC drivers at runtime scope,
           at versions that carried the image's pgjdbc and mssql-jdbc CVEs. All
           are excluded; the Postgres driver comes back below at the version
           Spring Boot manages. -->
      <exclusions>
        <exclusion>
          <groupId>org.postgresql</groupId>
          <artifactId>postgresql</artifactId>
        </exclusion>
        <exclusion>
          <groupId>com.microsoft.sqlserver</groupId>
          <artifactId>mssql-jdbc</artifactId>
        </exclusion>
        <exclusion>
          <groupId>com.mysql</groupId>
          <artifactId>mysql-connector-j</artifactId>
        </exclusion>
        <exclusion>
          <groupId>org.mariadb.jdbc</groupId>
          <artifactId>mariadb-java-client</artifactId>
        </exclusion>
        <exclusion>
          <groupId>com.oracle.database.jdbc</groupId>
          <artifactId>ojdbc17</artifactId>
        </exclusion>
      </exclusions>
    </dependency>

    <!-- CIB seven REST API starter. Mounts the engine REST resources at
         /engine-rest/*. Without it the SPA's calls to /engine-rest/... get
         a 404 once they pass the security filter. -->
    <dependency>
      <groupId>org.cibseven.bpm.springboot</groupId>
      <artifactId>cibseven-bpm-spring-boot-starter-rest</artifactId>
      <version>${cibseven.version}</version>
    </dependency>

    <!-- Embedded servlet container for Spring MVC + the REST servlet. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- In-memory database: with no datasource configured, Spring Boot
         auto-configures an in-memory H2 instance for the engine. -->
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- CIB seven Connect plugin: makes the engine parse and run
         <camunda:connector> service tasks. Brings cibseven-connect-core. -->
    <dependency>
      <groupId>org.cibseven.bpm</groupId>
      <artifactId>cibseven-engine-plugin-connect</artifactId>
      <version>${cibseven.version}</version>
    </dependency>

    <!-- Official HTTP connector (connectorId="http-connector"). Pulls in
         httpclient5 transitively. The "Look up vehicle in registry" service
         task in vehicle-registration.bpmn uses it to call the backend
         microservice's vehicle registry via apiBaseUrl. -->
    <dependency>
      <groupId>org.cibseven.connect</groupId>
      <artifactId>cibseven-connect-http-client</artifactId>
      <version>${cibseven.version}</version>
    </dependency>

    <!-- FreeMarker template engine for connector input parameters. Lets the
         "Send approval email" service task assemble its JSON payload from a
         classpath template (templates/approval-email.json.ftl) instead of
         inlining the body in the BPMN. Discovered via JSR-223 — no Spring
         wiring needed; the connect plugin uses scriptFormat="freemarker" to
         look up the engine. -->
    <dependency>
      <groupId>org.cibseven.template-engines</groupId>
      <artifactId>cibseven-template-engines-freemarker</artifactId>
      <version>${cibseven.version}</version>
    </dependency>

    <!-- Spin engine plugin: registers the S() / JSON() / XML() JUEL functions
         so the BPMN can parse the http-connector's response body inline (e.g.
         ${S(response).prop('data').prop('price').numberValue()}). The Spin
         starter dependencies are <optional> in the CIB seven Spring Boot
         starter, so we pull them in explicitly. The Jackson dataformat
         registers the JSON SPI Spin needs to auto-detect the response body —
         without it, S(response) fails with SPIN-01004 "No matching data
         format detected". -->
    <dependency>
      <groupId>org.cibseven.bpm</groupId>
      <artifactId>cibseven-engine-plugin-spin</artifactId>
      <version>${cibseven.version}</version>
    </dependency>
    <dependency>
      <groupId>org.cibseven.spin</groupId>
      <artifactId>cibseven-spin-dataformat-json-jackson</artifactId>
      <version>${cibseven.version}</version>
    </dependency>

    <!-- CIB seven Keycloak Identity Provider Plugin: registers a
         ReadOnlyIdentityProvider that queries Keycloak's Admin REST API
         for users and groups. Engine then knows who the authenticated
         caller is and which groups they belong to, so candidateGroups
         on user tasks are actually enforced. Pinned to 2.1.0 (its latest);
         see cibseven.keycloak.version above for why it lags the engine. -->
    <dependency>
      <groupId>org.cibseven.bpm.extension</groupId>
      <artifactId>cibseven-keycloak</artifactId>
      <version>${cibseven.keycloak.version}</version>
    </dependency>

    <!-- Spring Security + OAuth2 resource server: validates incoming
         bearer tokens (signature, expiry, issuer, audience) against
         Keycloak's JWKS. The plugin's example RestApiSecurityConfig
         relies on these starters being on the classpath. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
    </dependency>
    <!-- Persistent database (the `postgres` profile) and Flyway, which owns
         the ACT_* schema (com.poc.cib7.db.V1__CibSevenSchema). Versions are
         managed by the Spring Boot parent. -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <!-- Validates submitted form values against the service pack's
         schemas/<form-id>.json (docs/security.md rule 2). The 2.x line is the
         Jackson 2 one this Boot 3.5 module runs; 3.x needs Jackson 3. -->
    <dependency>
      <groupId>com.networknt</groupId>
      <artifactId>json-schema-validator</artifactId>
      <version>2.0.8</version>
    </dependency>
    <!-- oauth2-client drives the legacy webapps' OAuth2 login flow against
         Keycloak (Authorization Code grant). The auto-config DOES NOT call
         OIDC discovery because we provide every endpoint explicitly under
         spring.security.oauth2.client.provider.keycloak.* (no issuer-uri).
         That keeps the engine startable in docker-compose, where the
         container can't reach the browser-visible Keycloak URL. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-oauth2-client</artifactId>
    </dependency>

    <!-- JUnit 5 + AssertJ + Mockito + Spring Test. The DMN tests run the
         standalone DMN engine (cibseven-engine-dmn, already on the classpath
         transitively via the webapp starter); the smoke test boots the full
         Spring context with the Keycloak identity plugin mocked out. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <repositories>
    <!-- Explicit Maven Central declaration. The cibseven parent POMs pull in
         the mulesoft-releases repo, which becomes the only configured remote
         on a fresh checkout and can't resolve AWS SDK v2 artifacts. Listing
         central here forces Maven to try it as well. -->
    <repository>
      <id>central</id>
      <url>https://repo.maven.apache.org/maven2</url>
      <releases><enabled>true</enabled></releases>
      <snapshots><enabled>false</enabled></snapshots>
    </repository>
  </repositories>

  <build>
    <!-- Tests deploy and render the pack's BPMN, DMN and templates, so the pack
         directory joins the test classpath. -->
    <testResources>
      <testResource>
        <directory>src/test/resources</directory>
      </testResource>
      <testResource>
        <directory>${services.pack.dir}</directory>
      </testResource>
    </testResources>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <folders>
            <folder>${services.pack.dir}</folder>
          </folders>
        </configuration>
      </plugin>
      <!-- Google Java Style, enforced: `spotless:check` runs during `verify`,
           `mvn spotless:apply` reformats. Requires the add-exports flags in
           the repo-root .mvn/jvm.config (google-java-format reaches into
           jdk.compiler internals on JDK 16+). -->
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>3.10.3</version>
        <configuration>
          <java>
            <googleJavaFormat>
              <version>1.36.1</version>
              <style>GOOGLE</style>
            </googleJavaFormat>
          </java>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
