{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated from docs/business/services/business-registration/forms/business-details.md (start variables). Do not hand-edit.",
  "x-process": "businessRegistration",
  "x-form": "start",
  "type": "object",
  "properties": {
    "companyName": {
      "allOf": [
        {
          "$ref": "https://companylab.ai/schemas/core/v1.json#/$defs/nonBlank"
        },
        {
          "maxLength": 200
        }
      ]
    },
    "boardMembers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "firstName": {
            "$ref": "https://companylab.ai/schemas/core/v1.json#/$defs/nonBlank"
          },
          "lastName": {
            "$ref": "https://companylab.ai/schemas/core/v1.json#/$defs/nonBlank"
          },
          "personalCode": {
            "$ref": "https://companylab.ai/schemas/core/v1.json#/$defs/personalCodeEE"
          }
        },
        "required": [
          "firstName",
          "lastName",
          "personalCode"
        ],
        "additionalProperties": false
      }
    },
    "shareCapital": {
      "type": "number",
      "minimum": 2500
    },
    "applicantAge": {
      "type": "integer",
      "minimum": 0,
      "maximum": 130
    }
  }
}
