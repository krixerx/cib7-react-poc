# Only the Flutter *source* is committed (lib/, pubspec.yaml, analysis_options.yaml).
# The platform scaffolding below is regenerated by `flutter create` inside the
# Docker build (mobile/Dockerfile) and in local dev — never committed, so the
# repo stays free of Flutter boilerplate.

# Generated platform folders
/android/
/ios/
/web/
/linux/
/macos/
/windows/

# Build + tool output
/build/
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
pubspec.lock

# IDE
*.iml
.idea/
