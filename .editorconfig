# Keeps editors aligned with the enforced formatters:
# google-java-format (Java, 2-space) and Prettier (TS/JS, 2-space).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.java]
indent_size = 2
max_line_length = 100

[*.{yml,yaml,json,ts,tsx,js,jsx,mjs,css,html}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
