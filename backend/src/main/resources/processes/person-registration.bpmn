<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_PersonRegistration"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="cib7-react-poc" exporterVersion="0.2.0">
  <!--
    Person Registration process.

      start
        -> [Submit personal details]   user task   (react:personal-details)
        -> (Get price)                 service task (rest-datasonnet connector)
        -> [Review application]        user task   (react:review-application)
        -> <Approved?>                 exclusive gateway
        -> end

    Process variables:
      firstName, lastName, age   - written by the first user task
      objectId                   - written by the first user task (selected product)
      price                      - written by the Get price service task
      decision                   - written by the review user task ("approve"/"reject")

    The "Get price" service task uses the rest-datasonnet Connect SPI connector
    to GET https://api.restful-api.dev/objects/{objectId} and maps data.price
    from the response into the 'price' variable with an inline DataSonnet script.
  -->
  <bpmn:process id="personRegistration" name="Person Registration" isExecutable="true" camunda:historyTimeToLive="P30D">

    <bpmn:startEvent id="StartEvent_1" name="Registration started">
      <bpmn:outgoing>Flow_Start_Submit</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:sequenceFlow id="Flow_Start_Submit" sourceRef="StartEvent_1" targetRef="Task_SubmitDetails" />

    <bpmn:userTask id="Task_SubmitDetails" name="Submit personal details" camunda:formKey="react:personal-details">
      <bpmn:incoming>Flow_Start_Submit</bpmn:incoming>
      <bpmn:outgoing>Flow_Submit_GetPrice</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:sequenceFlow id="Flow_Submit_GetPrice" sourceRef="Task_SubmitDetails" targetRef="Task_GetPrice" />

    <bpmn:serviceTask id="Task_GetPrice" name="Get price" camunda:asyncBefore="true">
      <bpmn:extensionElements>
        <camunda:connector>
          <camunda:connectorId>rest-datasonnet</camunda:connectorId>
          <camunda:inputOutput>
            <camunda:inputParameter name="url">https://api.restful-api.dev/objects/${objectId}</camunda:inputParameter>
            <camunda:inputParameter name="method">GET</camunda:inputParameter>
            <camunda:inputParameter name="source">{}</camunda:inputParameter>
            <!-- Inline DataSonnet: map data.price from the response into 'result'. -->
            <camunda:inputParameter name="responseMapping"><![CDATA[/** DataSonnet version=2.0 */
payload.data.price
]]></camunda:inputParameter>
            <camunda:outputParameter name="price">${result}</camunda:outputParameter>
            <camunda:outputParameter name="restOutcome">${restOutcome}</camunda:outputParameter>
          </camunda:inputOutput>
        </camunda:connector>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Submit_GetPrice</bpmn:incoming>
      <bpmn:outgoing>Flow_GetPrice_Review</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="Flow_GetPrice_Review" sourceRef="Task_GetPrice" targetRef="Task_Review" />

    <bpmn:userTask id="Task_Review" name="Review application" camunda:formKey="react:review-application">
      <bpmn:incoming>Flow_GetPrice_Review</bpmn:incoming>
      <bpmn:outgoing>Flow_Review_Gateway</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:sequenceFlow id="Flow_Review_Gateway" sourceRef="Task_Review" targetRef="Gateway_Decision" />

    <bpmn:exclusiveGateway id="Gateway_Decision" name="Approved?" default="Flow_Rejected">
      <bpmn:incoming>Flow_Review_Gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_Approved</bpmn:outgoing>
      <bpmn:outgoing>Flow_Rejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="Flow_Approved" name="approved" sourceRef="Gateway_Decision" targetRef="EndEvent_Approved">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${decision == "approve"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_Rejected" name="rejected" sourceRef="Gateway_Decision" targetRef="EndEvent_Rejected" />

    <bpmn:endEvent id="EndEvent_Approved" name="Application approved">
      <bpmn:incoming>Flow_Approved</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndEvent_Rejected" name="Application rejected">
      <bpmn:incoming>Flow_Rejected</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="personRegistration">
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="160" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="146" y="225" width="65" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SubmitDetails_di" bpmnElement="Task_SubmitDetails">
        <dc:Bounds x="250" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_GetPrice_di" bpmnElement="Task_GetPrice">
        <dc:Bounds x="410" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Review_di" bpmnElement="Task_Review">
        <dc:Bounds x="570" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Decision_di" bpmnElement="Gateway_Decision" isMarkerVisible="true">
        <dc:Bounds x="735" y="175" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="738" y="145" width="55" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Approved_di" bpmnElement="EndEvent_Approved">
        <dc:Bounds x="872" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="857" y="145" width="67" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Rejected_di" bpmnElement="EndEvent_Rejected">
        <dc:Bounds x="872" y="262" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="860" y="305" width="61" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_Start_Submit_di" bpmnElement="Flow_Start_Submit">
        <di:waypoint x="196" y="200" />
        <di:waypoint x="250" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Submit_GetPrice_di" bpmnElement="Flow_Submit_GetPrice">
        <di:waypoint x="350" y="200" />
        <di:waypoint x="410" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_GetPrice_Review_di" bpmnElement="Flow_GetPrice_Review">
        <di:waypoint x="510" y="200" />
        <di:waypoint x="570" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Review_Gateway_di" bpmnElement="Flow_Review_Gateway">
        <di:waypoint x="670" y="200" />
        <di:waypoint x="735" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Approved_di" bpmnElement="Flow_Approved">
        <di:waypoint x="760" y="175" />
        <di:waypoint x="760" y="120" />
        <di:waypoint x="872" y="120" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="772" y="102" width="48" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Rejected_di" bpmnElement="Flow_Rejected">
        <di:waypoint x="760" y="225" />
        <di:waypoint x="760" y="280" />
        <di:waypoint x="872" y="280" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="774" y="262" width="45" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
