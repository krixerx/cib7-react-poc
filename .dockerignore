# Applies to docker builds that use the repo root as context and bring no
# <module>/Dockerfile.dockerignore of their own: today only mcp/, which
# reads the pack's specs folder and engine form schemas, and the core's
# shared schema definitions (the one file kept from cib7/ below).

# Git + per-machine state.
.git
.claude
.project
.settings
.idea
.vscode
*.iml
.DS_Store
Thumbs.db
*.log

# Heavy build artifacts everywhere.
**/node_modules
**/target
**/dist

# Sibling services / directories the mcp image doesn't need.
cib7
!cib7/src/main/resources/schemas/core-v1.json
pdf-renderer
frontend
keycloak
scripts
README.md
TODOS.md

# Top-level docs are excluded; mcp needs only the pack's specs folder.
# (packs/ intentionally NOT excluded — the matchers above
# don't reach into it.)
docs/*.md
