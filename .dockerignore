# Applies to docker builds that use the repo root as context and bring no
# <module>/Dockerfile.dockerignore of their own: today only mcp/, which
# needs the core's shared schema definitions (the one file kept from cib7/
# below); the pack's files come in its own image layer.

# Git + per-machine state.
.git
.claude
.project
.settings
.idea
.vscode
*.iml
.DS_Store
Thumbs.db
*.log

# Heavy build artifacts everywhere.
**/node_modules
**/target
**/dist

# Sibling services / directories the mcp image doesn't need.
cib7
!cib7/src/main/resources/schemas/core-v1.json
pdf-renderer
frontend
keycloak
scripts
README.md
TODOS.md

# The pack is a layer on top of the mcp image, not part of it.
packs
docs/*.md
