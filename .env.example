# ============================================================================
# cib7-react-poc — production deployment env file
#
# Copy to `.env` and edit before running:
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build
#
# Anything left blank falls back to the docker-compose.yml default, which
# assumes browsers hit localhost — only correct for single-machine dev.
# ============================================================================

# --- Public URLs --------------------------------------------------------------
# What URLs end users (and their AI clients) type into the browser.
# Use https:// if a TLS terminator sits in front of the stack (recommended).

# Public Keycloak base URL. Becomes Keycloak's KC_HOSTNAME_URL and the
# `iss` claim stamped into every JWT. Browsers, the SPA, and the MCP
# sidecar's resource metadata all use this.
PUBLIC_KEYCLOAK_URL=https://kc.example.com

# Public SPA base URL. Used in owner-confirmation email links
# (${frontendBaseUrl}/consent/<purpose>/{token}) and as the public MCP host
# (${PUBLIC_FRONTEND_URL}/mcp). Keycloak also expands it into the
# redirect URIs, web origins and post-logout URLs of the cib7-frontend,
# cib7-webapps and cib7-mobile clients while it imports the realm, so it
# must be exactly the origin the browser shows, scheme included.
PUBLIC_FRONTEND_URL=https://app.example.com

# Public CIB seven engine base URL (Cockpit / Tasklist / Admin SSO).
# With the Traefik ingress in front of the stack, the engine is no longer
# a separate public host — Traefik routes /engine-rest, /api, /camunda,
# /oauth2, /login, /logout under ${PUBLIC_FRONTEND_URL}. Leave this set
# to the same host as PUBLIC_FRONTEND_URL unless you have a custom setup
# that splits engine and SPA across origins (which also requires updating
# the cib7-webapps client redirectUris in keycloak/realm-export.json).
PUBLIC_ENGINE_URL=https://app.example.com

# --- Keycloak admin -----------------------------------------------------------
# Replace the dev admin/admin. The bootstrap admin is created on first
# start only — once the realm is imported, change via the admin console.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME

# --- Realm client secrets -----------------------------------------------------
# These mirror the secrets baked into keycloak/realm-export.json. The
# realm export is your source of truth — edit the JSON before first boot,
# then put the same values here so the engine and MCP sidecar can use
# them. After first boot, rotate via the Keycloak admin console AND
# update these env vars (the engine reads them at process startup).
KEYCLOAK_BACKEND_CLIENT_SECRET=CHANGE_ME
KEYCLOAK_WEBAPPS_CLIENT_SECRET=CHANGE_ME
# Service-account client the backend business microservice uses for its
# /engine-rest calls (client_credentials grant). Mirrors the cib7-business
# client in keycloak/realm-export.json.
KEYCLOAK_BUSINESS_CLIENT_SECRET=CHANGE_ME

# --- Public MCP endpoint ------------------------------------------------------
# Override only if you publish MCP on a different host than the SPA.
# Defaults to ${PUBLIC_FRONTEND_URL}/mcp via the compose overlay.
# MCP_RESOURCE_URL=https://app.example.com/mcp

# --- RustFS (object storage) --------------------------------------------------
# Public S3 endpoint = what the browser hits with presigned PUT / GET URLs
# minted by the backend business service. In prod, this is a TLS-fronted
# subdomain (e.g. https://s3.example.com) — set RUSTFS_DOMAIN inside the
# rustfs container to match so virtual-host signing checks pass.
PUBLIC_S3_URL=https://s3.example.com

# RustFS root credentials. The backend business service uses the same pair
# as its S3_ACCESS_KEY / S3_SECRET_KEY to authenticate against RustFS and
# mint presigned URLs.
RUSTFS_ACCESS_KEY=CHANGE_ME
RUSTFS_SECRET_KEY=CHANGE_ME

# Shared secret for the backend's engine-only /api/internal/** endpoints. The
# integration bus (esb) injects it as X-Internal-Token; the engine never holds it.
# Rotated like the Keycloak client secrets; same length / entropy.
INTERNAL_TASK_TOKEN=CHANGE_ME

# The engine's credential towards the integration bus (esb): cib7 sends it as
# X-Bus-Token on every outbound call and the bus refuses calls without it, so
# nothing else on the network can make the bus add X-Internal-Token. Set on
# both cib7 and esb from this one value.
BUS_TOKEN=CHANGE_ME

# HMAC key for the capability links (co-owner confirmation, founder
# signature, payment). cib7 mints the links and the backend verifies them, so
# both read this one value. Rotating it invalidates every link already sent.
LINK_SIGNING_SECRET=CHANGE_ME

# Key the payment provider signs its callbacks with; the backend accepts a
# payment only with a valid HMAC (docs/security.md rule 4). The demo's mock
# provider uses the same value.
PAYMENT_PROVIDER_SECRET=CHANGE_ME

# --- Database (Postgres) -----------------------------------------------------
# One Postgres container holds the engine's database (cib7) and the
# backend's (backend), each with its own login role. postgres/init creates
# both on the FIRST start of an empty data volume only: changing a value here
# later does not change the database (use ALTER ROLE in psql). Blank falls
# back to the published dev defaults in docker-compose.yml.
POSTGRES_PASSWORD=CHANGE_ME
ENGINE_DB_PASSWORD=CHANGE_ME
BACKEND_DB_PASSWORD=CHANGE_ME

# --- Centralised logging (Graylog) --------------------------------------------
# Graylog is never published on a routable interface: the web UI is bound to
# 127.0.0.1 on the deployment host and the GELF inputs live on the docker
# network only. Reach the UI through an SSH tunnel:
#     ssh -N -L 9900:127.0.0.1:9900 <user>@<host>
# then open http://localhost:9900. See docs/logging.md.

# Encrypts secrets Graylog stores in MongoDB. At least 16 characters, and it
# must NOT change once there is data — a new value makes the old ciphertexts
# unreadable. Generate one with:
#     head -c 96 /dev/urandom | base64 | tr -d '\n=+/' | head -c 96
GRAYLOG_PASSWORD_SECRET=CHANGE_ME

# Web UI password for the `admin` account, in two forms. Graylog itself only
# takes the SHA-256; the plaintext is used by the graylog-init sidecar, which
# calls the REST API to create the GELF inputs.
#     echo -n 'your-password' | sha256sum
GRAYLOG_ROOT_PASSWORD=CHANGE_ME
GRAYLOG_ROOT_PASSWORD_SHA2=CHANGE_ME

# What the browser types after the tunnel is up. Change this together with the
# published port in docker-compose.yml if 9900 is taken on your machine.
# GRAYLOG_HTTP_EXTERNAL_URI=http://127.0.0.1:9900/

# Pin a different Graylog image (e.g. graylog/graylog:6.3) without touching
# the compose file.
# GRAYLOG_IMAGE=graylog/graylog:7.1
