# ============================================================================
# cib7-react-poc — production deployment env file
#
# Copy to `.env` and edit before running:
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build
#
# Anything left blank falls back to the docker-compose.yml default, which
# assumes browsers hit localhost — only correct for single-machine dev.
# ============================================================================

# --- Public URLs --------------------------------------------------------------
# What URLs end users (and their AI clients) type into the browser.
# Use https:// if a TLS terminator sits in front of the stack (recommended).

# Public Keycloak base URL. Becomes Keycloak's KC_HOSTNAME_URL and the
# `iss` claim stamped into every JWT. Browsers, the SPA, and the MCP
# sidecar's resource metadata all use this.
PUBLIC_KEYCLOAK_URL=https://kc.example.com

# Public SPA base URL. Used in owner-confirmation email links
# (${frontendBaseUrl}/confirm-owner/{token}) and as the public MCP host
# (${PUBLIC_FRONTEND_URL}/mcp).
PUBLIC_FRONTEND_URL=https://app.example.com

# Public CIB seven engine base URL (Cockpit / Tasklist / Admin SSO).
# With the Traefik ingress in front of the stack, the engine is no longer
# a separate public host — Traefik routes /engine-rest, /api, /camunda,
# /oauth2, /login, /logout under ${PUBLIC_FRONTEND_URL}. Leave this set
# to the same host as PUBLIC_FRONTEND_URL unless you have a custom setup
# that splits engine and SPA across origins (which also requires updating
# the cib7-webapps client redirectUris in keycloak/realm-export.json).
PUBLIC_ENGINE_URL=https://app.example.com

# --- Keycloak admin -----------------------------------------------------------
# Replace the dev admin/admin. The bootstrap admin is created on first
# start only — once the realm is imported, change via the admin console.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME

# --- Realm client secrets -----------------------------------------------------
# These mirror the secrets baked into keycloak/realm-export.json. The
# realm export is your source of truth — edit the JSON before first boot,
# then put the same values here so the engine and MCP sidecar can use
# them. After first boot, rotate via the Keycloak admin console AND
# update these env vars (the engine reads them at process startup).
KEYCLOAK_BACKEND_CLIENT_SECRET=CHANGE_ME
KEYCLOAK_WEBAPPS_CLIENT_SECRET=CHANGE_ME
# Service-account client the backend business microservice uses for its
# /engine-rest calls (client_credentials grant). Mirrors the cib7-business
# client in keycloak/realm-export.json.
KEYCLOAK_BUSINESS_CLIENT_SECRET=CHANGE_ME

# --- Public MCP endpoint ------------------------------------------------------
# Override only if you publish MCP on a different host than the SPA.
# Defaults to ${PUBLIC_FRONTEND_URL}/mcp via the compose overlay.
# MCP_RESOURCE_URL=https://app.example.com/mcp

# --- RustFS (object storage) --------------------------------------------------
# Public S3 endpoint = what the browser hits with presigned PUT / GET URLs
# minted by the backend business service. In prod, this is a TLS-fronted
# subdomain (e.g. https://s3.example.com) — set RUSTFS_DOMAIN inside the
# rustfs container to match so virtual-host signing checks pass.
PUBLIC_S3_URL=https://s3.example.com

# RustFS root credentials. The backend business service uses the same pair
# as its S3_ACCESS_KEY / S3_SECRET_KEY to authenticate against RustFS and
# mint presigned URLs.
RUSTFS_ACCESS_KEY=CHANGE_ME
RUSTFS_SECRET_KEY=CHANGE_ME

# Shared secret used by BPMN service tasks to call the backend's internal
# /api/documents/move-pending and /api/documents/server-upload endpoints.
# Rotated like the Keycloak client secrets; same length / entropy.
INTERNAL_TASK_TOKEN=CHANGE_ME
