{
  "name": "cib7-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Standalone MCP microservice for the CIB seven POC. Wraps /engine-rest with applicant-side MCP tools and serves discovery metadata. T1 spike: hello-world echo + OAuth2 PKCE-loopback verification.",
  "main": "src/server.ts",
  "scripts": {
    "start": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest --passWithNoTests"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.18.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "jose": "^5.9.6",
    "tsx": "^4.19.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.19.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "proxy-addr": "^2.0.8"
  }
}
